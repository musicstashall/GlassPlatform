// Общий VERSIONINFO для нативных бинарников Glass.
// Числовые версии — из генерируемого GlassBuildVersion.h (Directory.Build.targets).
// Версия продукта — GlassProductVersion в Directory.Build.props. Не править версии здесь.
#include <winver.h>
#include "GlassBuildVersion.h"

#ifndef GLASS_VER_COMMA
#define GLASS_VER_COMMA 0,0,0,0
#endif
#ifndef GLASS_VER_DOT
#define GLASS_VER_DOT 0.0.0.0
#endif
#ifndef GLASS_VER_PRODUCT_COMMA
#define GLASS_VER_PRODUCT_COMMA GLASS_VER_COMMA
#endif
#ifndef GLASS_VER_PRODUCT_DOT
#define GLASS_VER_PRODUCT_DOT GLASS_VER_DOT
#endif
#ifndef GLASS_VER_MODULE
#define GLASS_VER_MODULE Glass
#endif
#ifndef GLASS_VER_EXT
#define GLASS_VER_EXT dll
#endif
#ifndef GLASS_VER_FILETYPE
#define GLASS_VER_FILETYPE 0x2L
#endif

#define GLASS_VER_STRINGIZE2(x) #x
#define GLASS_VER_STRINGIZE(x) GLASS_VER_STRINGIZE2(x)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION GLASS_VER_COMMA
 PRODUCTVERSION GLASS_VER_PRODUCT_COMMA
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE GLASS_VER_FILETYPE
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Glass"
            VALUE "FileDescription", GLASS_VER_STRINGIZE(GLASS_VER_MODULE)
            VALUE "FileVersion", GLASS_VER_STRINGIZE(GLASS_VER_DOT)
            VALUE "InternalName", GLASS_VER_STRINGIZE(GLASS_VER_MODULE)
            VALUE "OriginalFilename", GLASS_VER_STRINGIZE(GLASS_VER_MODULE) "." GLASS_VER_STRINGIZE(GLASS_VER_EXT)
            VALUE "ProductName", "Glass Platform"
            VALUE "ProductVersion", GLASS_VER_STRINGIZE(GLASS_VER_PRODUCT_DOT)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
