<Project Sdk="WixToolset.Sdk">
  <PropertyGroup>
    <ProjectGuid>{D1E2F3A4-B5C6-4789-0ABC-DEF123456789}</ProjectGuid>
    <Configurations>Debug;Release</Configurations>
