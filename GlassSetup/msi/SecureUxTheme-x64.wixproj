    <GlassSignThisProject>false</GlassSignThisProject>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <BuildProject>false</BuildProject>
  </PropertyGroup>
  <ItemGroup>
