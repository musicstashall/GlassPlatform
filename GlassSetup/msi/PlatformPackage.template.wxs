<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="$(var.GlassPlatformTitle)"
           Manufacturer="Glass"
           Version="$(var.GlassMsiVersion)"
           UpgradeCode="$(var.GlassUpgradeCode)"
           ProductCode="$(var.GlassProductCode)"
           Scope="perUser"
           Compressed="yes">
    <MajorUpgrade AllowDowngrades="no" AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="Установлена более новая версия Glass Platform." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="GlassProductIcon" SourceFile="$(var.GlassSetupIcon)" />
    <Property Id="ARPPRODUCTICON" Value="GlassProductIcon" />
    <Property Id="GLASSBUNDLEVERSION" Value="$(var.GlassMsiBundleVersion)" Hidden="yes" />

    <Feature Id="MainFeature" Title="$(var.GlassPlatformTitle)" Level="1">
      <ComponentGroupRef Id="GlassPayloadFiles" />
      <ComponentRef Id="GlassInstallPathRegistry" />
      <ComponentRef Id="GlassUninstallExe" />
      <ComponentRef Id="GlassUninstallDat" />
    </Feature>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLDIR" Name="GlassPlatform" />
    </StandardDirectory>

    <Component Id="GlassInstallPathRegistry" Directory="INSTALLDIR" Guid="*">
      <RegistryKey Root="HKCU" Key="Software\GlassPlatform">
        <RegistryValue Name="InstallPath" Type="string" Value="[INSTALLDIR]" KeyPath="yes" />
      </RegistryKey>
    </Component>

    <Component Id="GlassUninstallExe" Directory="INSTALLDIR" Guid="*">
      <File Id="GlassUninsExe" Source="$(var.GlassUninsExe)" Name="unins000.exe" KeyPath="yes" />
    </Component>
    <Component Id="GlassUninstallDat" Directory="INSTALLDIR" Guid="*">
      <File Id="GlassUninsDat" Source="$(var.GlassPayloadStage)\unins000.dat" Name="unins000.dat" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
