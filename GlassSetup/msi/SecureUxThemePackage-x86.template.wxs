<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="$(var.GlassPlatformTitle)"
           Manufacturer="Glass"
           Version="$(var.GlassMsiVersion)"
           UpgradeCode="$(var.GlassUpgradeCode)"
           ProductCode="$(var.GlassProductCode)"
           Scope="perMachine"
           Compressed="yes">
    <MajorUpgrade AllowDowngrades="no" AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="Установлена более новая версия SecureUxTheme." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="GlassProductIcon" SourceFile="$(var.GlassSetupIcon)" />
    <Property Id="ARPPRODUCTICON" Value="GlassProductIcon" />
    <Property Id="GLASSBUNDLEVERSION" Value="$(var.GlassMsiBundleVersion)" Hidden="yes" />
    <Property Id="GLASS_RESTORE_NO_CAB" Value="0" Hidden="yes" />

    <Binary Id="SecureUxThemeCa" SourceFile="$(var.SecureUxThemeCaDll)" />

    <CustomAction Id="SecureUxThemeCaInstall" BinaryRef="SecureUxThemeCa" DllEntry="SecureUxThemeCaInstall"
                  Execute="commit" Impersonate="no" Return="check" />
    <CustomAction Id="SecureUxThemeCaUninstall" BinaryRef="SecureUxThemeCa" DllEntry="SecureUxThemeCaUninstall"
                  Execute="commit" Impersonate="no" Return="check" />

    <Feature Id="MainFeature" Title="$(var.GlassPlatformTitle)" Level="1">
      <ComponentRef Id="SecureUxThemePatcher" />
      <ComponentRef Id="SecureUxThemeProxyNative" />
    </Feature>

    <StandardDirectory Id="System6432Folder">
      <Component Id="SecureUxThemePatcher" Guid="*">
        <File Id="SecureUxTheme4Dll" Source="$(var.GlassPayloadStage)\SecureUxTheme4.dll" KeyPath="yes" />
      </Component>
      <Component Id="SecureUxThemeProxyNative" Guid="*">
        <File Id="ThemeUiProxyNative" Source="$(var.GlassPayloadStage)\ThemeUiProxy.dll" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <InstallExecuteSequence>
      <InstallFiles Condition="GLASS_RESTORE_NO_CAB &lt;&gt; 1" />
      <Custom Action="SecureUxThemeCaInstall" After="InstallFiles" Condition="NOT Installed" />
      <Custom Action="SecureUxThemeCaUninstall" Before="RemoveFiles" Condition="Installed AND NOT REINSTALL" />
    </InstallExecuteSequence>
  </Package>
</Wix>
