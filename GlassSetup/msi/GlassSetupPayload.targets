<Project>
  <PropertyGroup>
    <GlassPayloadArch Condition="'$(MSBuildProjectName)' == 'Glass-x64'">x64</GlassPayloadArch>
    <GlassPayloadArch Condition="'$(MSBuildProjectName)' == 'Glass-x86'">x86</GlassPayloadArch>
    <GlassPayloadArch Condition="'$(MSBuildProjectName)' == 'OpenGlass-x64'">OpenGlass</GlassPayloadArch>
    <GlassBuildRelease Condition="'$(GlassPayloadArch)' == 'OpenGlass'">$([System.IO.Path]::Combine('$(SolutionRoot)', 'Build', 'x64', 'Release'))</GlassBuildRelease>
    <GlassBuildRelease Condition="'$(GlassPayloadArch)' != 'OpenGlass'">$([System.IO.Path]::Combine('$(SolutionRoot)', 'Build', '$(GlassPayloadArch)', 'Release'))</GlassBuildRelease>
    <GlassPayloadStage>$([System.IO.Path]::Combine('$(SolutionRoot)', 'Build', 'SetupPayload', '$(GlassPayloadArch)'))</GlassPayloadStage>
    <GlassHarvestWxs>$(BaseIntermediateOutputPath)$(MSBuildProjectName).Harvest.wxs</GlassHarvestWxs>
    <GlassHarvestScript>$(MSBuildThisFileDirectory)scripts\Generate-HarvestWxs.ps1</GlassHarvestScript>
    <GlassProductVersionBase3>$([System.Text.RegularExpressions.Regex]::Match('$(GlassProductVersion)', '^\d+\.\d+\.\d+').Value)</GlassProductVersionBase3>
    <GlassBundleBuildNumberEffective Condition="'$(GlassBundleBuildNumber)' != ''">$(GlassBundleBuildNumber)</GlassBundleBuildNumberEffective>
    <GlassBundleBuildNumberEffective Condition="'$(GlassBundleBuildNumberEffective)' == ''">0</GlassBundleBuildNumberEffective>
    <!-- MSI ProductVersion: базовая тройка + номер комплекта (числовое поле, без ведущих нулей). -->
    <GlassMsiVersion>$(GlassProductVersionBase3).$(GlassBundleBuildNumberEffective)</GlassMsiVersion>
    <GlassMsiBundleVersion Condition="'$(GlassBundleVersion)' != ''">$(GlassBundleVersion)</GlassMsiBundleVersion>
    <GlassMsiBundleVersion Condition="'$(GlassMsiBundleVersion)' == ''">$(GlassMsiVersion)</GlassMsiBundleVersion>
    <GlassUninsExePath>$([System.IO.Path]::Combine('$(SolutionRoot)', 'Build', 'GlassUnins', 'Release', 'GlassUnins.exe'))</GlassUninsExePath>
    <GlassSetupIconPath>$([System.IO.Path]::Combine('$(SolutionRoot)', 'GlassSetup', 'res', 'app.ico'))</GlassSetupIconPath>
    <GlassSecureUxThemeVendorDir>$([System.IO.Path]::Combine('$(SolutionRoot)', 'GlassSetup', 'third_party', 'SecureUxTheme', '$(GlassPayloadArch)'))</GlassSecureUxThemeVendorDir>
  </PropertyGroup>

  <!-- Release: single-file Publish до staging MSI (Unpackaged остаётся промежуточным OutputPath). -->
  <Target Name="GlassEnsureGlassSettingsPublish"
          BeforeTargets="GlassStagePayload"
          Condition="'$(GlassPayloadArch)' == 'x64' or '$(GlassPayloadArch)' == 'x86'">
    <Message Importance="high" Text="GlassSettings Publish $(GlassPayloadArch) before MSI" />
    <MSBuild Projects="$(SolutionRoot)GlassSettings\GlassSettings.csproj"
             Targets="Publish"
             Properties="Configuration=Release;Platform=$(GlassPayloadArch);GlassSettingsSkipPublishForMsi=true" />
  </Target>

  <!-- SecureUxTheme: vendored в репо → Build\…\Release\SecureUxTheme перед staging (Build\ в git нет). -->
  <Target Name="GlassMaterializeSecureUxTheme"
          BeforeTargets="GlassStagePayload"
          Condition="'$(GlassPayloadArch)' == 'x64' or '$(GlassPayloadArch)' == 'x86'">
    <PropertyGroup>
      <_SutReleaseDir>$(GlassBuildRelease)\SecureUxTheme\</_SutReleaseDir>
    </PropertyGroup>
    <Error Condition="!Exists('$(GlassSecureUxThemeVendorDir)\SecureUxTheme4.dll')"
      Text="SecureUxTheme missing: $(GlassSecureUxThemeVendorDir)\SecureUxTheme4.dll and ThemeUiProxy.dll (see GlassSetup\third_party\SecureUxTheme)." />
    <MakeDir Directories="$(_SutReleaseDir)" />
    <Copy SourceFiles="$(GlassSecureUxThemeVendorDir)\SecureUxTheme4.dll;$(GlassSecureUxThemeVendorDir)\ThemeUiProxy.dll"
          DestinationFolder="$(_SutReleaseDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="GlassStagePayload" BeforeTargets="GlassGenerateHarvest" DependsOnTargets="GlassEnsureGlassSettingsPublish;GlassMaterializeSecureUxTheme" Condition="'$(GlassPayloadArch)' != ''">
    <Message Importance="high" Text="Glass MSI: staging $(GlassPayloadArch) from $(GlassBuildRelease)" />
    <RemoveDir Directories="$(GlassPayloadStage)" Condition="Exists('$(GlassPayloadStage)')" />
    <MakeDir Directories="$(GlassPayloadStage)" />

    <!-- Платформа x64/x86 -->
    <ItemGroup Condition="'$(GlassPayloadArch)' == 'x64' or '$(GlassPayloadArch)' == 'x86'">
      <GlassNative Include="$(GlassBuildRelease)\ExplorerCompat.dll" />
      <GlassNative Include="$(GlassBuildRelease)\GlassCompat.dll" />
      <GlassNative Include="$(GlassBuildRelease)\GlassCore.dll" />
      <GlassNative Include="$(GlassBuildRelease)\GlassShellExt.dll" />
      <GlassNative Include="$(GlassBuildRelease)\GlassShellHost.exe" />
      <GlassNative Include="$(GlassBuildRelease)\TaskbarCompat.dll" />
      <GlassNative Include="$(GlassBuildRelease)\UICompat.dll" />
      <GlassNative Include="$(GlassBuildRelease)\WndCompat.dll" />
      <GlassNative Include="$(GlassBuildRelease)\vcruntime140.dll" Condition="Exists('$(GlassBuildRelease)\vcruntime140.dll')" />
      <GlassNative Include="$(GlassBuildRelease)\vcruntime140_1.dll" Condition="Exists('$(GlassBuildRelease)\vcruntime140_1.dll')" />
      <GlassNative Include="$(GlassBuildRelease)\msvcp140.dll" Condition="Exists('$(GlassBuildRelease)\msvcp140.dll')" />
      <GlassNative Include="$(GlassBuildRelease)\msvcp140_1.dll" Condition="Exists('$(GlassBuildRelease)\msvcp140_1.dll')" />
      <GlassNative Include="$(GlassBuildRelease)\msvcp140_2.dll" Condition="Exists('$(GlassBuildRelease)\msvcp140_2.dll')" />
      <GlassNative Include="$(GlassBuildRelease)\concrt140.dll" Condition="Exists('$(GlassBuildRelease)\concrt140.dll')" />
      <GlassSettingsPublish Include="$(GlassBuildRelease)\GlassSettings\**\*.*"
        Exclude="$(GlassBuildRelease)\GlassSettings\**\*.pdb;$(GlassBuildRelease)\GlassSettings\**\*.xaml;$(GlassBuildRelease)\GlassSettings\Package.appxmanifest;$(GlassBuildRelease)\GlassSettings\app.manifest;$(GlassBuildRelease)\GlassSettings\Properties\**\*.*;$(GlassBuildRelease)\GlassSettings\Microsoft.UI.Designer.dll;$(GlassBuildRelease)\GlassSettings\Microsoft.UI.Xaml\Assets\map.html;$(GlassBuildRelease)\GlassSettings\Microsoft.Windows.Workloads.pri;$(GlassBuildRelease)\GlassSettings\Assets\StoreLogo.png;$(GlassBuildRelease)\GlassSettings\Assets\SplashScreen.*;$(GlassBuildRelease)\GlassSettings\Assets\Square150x150Logo.*;$(GlassBuildRelease)\GlassSettings\Assets\Square44x44Logo.*;$(GlassBuildRelease)\GlassSettings\Assets\Wide310x150Logo.*;$(GlassBuildRelease)\GlassSettings\Assets\LockScreenLogo.*" />
      <GlassNativeExtra Include="$(GlassBuildRelease)\GlassSettings.Native.dll"
        Condition="'$(GlassPayloadArch)' == 'x86' and !Exists('$(GlassBuildRelease)\GlassSettings\GlassSettings.Native.dll')" />
      <GlassShellSparse Include="$(GlassBuildRelease)\GlassShellSparse\**\*.*" />
      <GlassSecureUxTheme Include="$(GlassBuildRelease)\SecureUxTheme\**\*.*" />
      <GlassUnins Include="$(GlassUninsExePath)" Condition="Exists('$(GlassUninsExePath)')" />
    </ItemGroup>

    <!-- OpenGlass x64 -->
    <ItemGroup Condition="'$(GlassPayloadArch)' == 'OpenGlass'">
      <GlassOg Include="$(GlassBuildRelease)\OpenGlass\OpenGlass.dll" Condition="Exists('$(GlassBuildRelease)\OpenGlass\OpenGlass.dll')" />
      <GlassOg Include="$(GlassBuildRelease)\OpenGlass\OpenGlassHost.exe" Condition="Exists('$(GlassBuildRelease)\OpenGlass\OpenGlassHost.exe')" />
      <GlassOgResources Include="$(GlassBuildRelease)\OpenGlass\Resources\**\*.*" Condition="Exists('$(GlassBuildRelease)\OpenGlass\Resources')" />
      <GlassUnins Include="$(GlassUninsExePath)" Condition="Exists('$(GlassUninsExePath)')" />
    </ItemGroup>

    <Copy SourceFiles="@(GlassNative)" DestinationFolder="$(GlassPayloadStage)" SkipUnchangedFiles="true" Condition="'@(GlassNative)' != ''" />
    <Copy SourceFiles="@(GlassNativeExtra)" DestinationFolder="$(GlassPayloadStage)\GlassSettings" SkipUnchangedFiles="true" Condition="'@(GlassNativeExtra)' != ''" />
    <Copy SourceFiles="@(GlassSettingsPublish)" DestinationFiles="@(GlassSettingsPublish->'$(GlassPayloadStage)\GlassSettings\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(GlassSettingsPublish)' != ''" />
    <Copy SourceFiles="@(GlassShellSparse)" DestinationFiles="@(GlassShellSparse->'$(GlassPayloadStage)\GlassShellSparse\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(GlassShellSparse)' != ''" />
    <Copy SourceFiles="@(GlassSecureUxTheme)" DestinationFiles="@(GlassSecureUxTheme->'$(GlassPayloadStage)\SecureUxTheme\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(GlassSecureUxTheme)' != ''" />
    <Error Condition="('$(GlassPayloadArch)' == 'x64' or '$(GlassPayloadArch)' == 'x86') and !Exists('$(GlassBuildRelease)\GlassShellSparse\AppxManifest.xml')"
      Text="Glass $(GlassPayloadArch) MSI: GlassShellSparse missing — соберите GlassShellExt Release (Win32 для x86, x64 для x64)." />
    <Error Condition="('$(GlassPayloadArch)' == 'x64' or '$(GlassPayloadArch)' == 'x86') and !Exists('$(GlassPayloadStage)\SecureUxTheme\SecureUxTheme4.dll')"
      Text="Glass $(GlassPayloadArch) MSI: SecureUxTheme не попал в staging." />
    <Copy SourceFiles="@(GlassOg)" DestinationFolder="$(GlassPayloadStage)" SkipUnchangedFiles="true" Condition="'@(GlassOg)' != ''" />
    <Copy SourceFiles="@(GlassOgResources)" DestinationFiles="@(GlassOgResources->'$(GlassPayloadStage)\Resources\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(GlassOgResources)' != ''" />
    <MakeDir Directories="$(GlassPayloadStage)\Resources\ThemeMaterial" Condition="'$(GlassPayloadArch)' == 'OpenGlass' and !Exists('$(GlassPayloadStage)\Resources\ThemeMaterial')" />
    <MakeDir Directories="$(GlassPayloadStage)" Condition="!Exists('$(GlassPayloadStage)')" />
    <WriteLinesToFile File="$(GlassPayloadStage)\unins000.dat" Lines="PRODUCT_CODE={$(GlassMsiProductCode)}" Overwrite="true" Condition="'$(GlassMsiProductCode)' != ''" />
  </Target>

  <PropertyGroup>
    <GlassProductMetadataWxi>$(MSBuildThisFileDirectory)ProductMetadata.$(GlassPayloadArch).wxi</GlassProductMetadataWxi>
    <GlassPlatformWxs>$(BaseIntermediateOutputPath)$(MSBuildProjectName).PlatformPackage.wxs</GlassPlatformWxs>
    <GlassPlatformTemplate Condition="'$(MSBuildProjectName)' == 'OpenGlass-x64'">$(MSBuildThisFileDirectory)OpenGlassPackage.template.wxs</GlassPlatformTemplate>
    <GlassPlatformTemplate Condition="'$(MSBuildProjectName)' != 'OpenGlass-x64'">$(MSBuildThisFileDirectory)PlatformPackage.template.wxs</GlassPlatformTemplate>
    <GlassPlatformScript>$(MSBuildThisFileDirectory)scripts\Generate-PlatformWxs.ps1</GlassPlatformScript>
  </PropertyGroup>

  <Target Name="GlassWriteProductMetadata" BeforeTargets="GlassGenerateHarvest" DependsOnTargets="GlassStagePayload;GlassBundlePrepareSession" Condition="'$(GlassPayloadArch)' != ''">
    <PropertyGroup>
      <_GlassProductVersion Condition="'$(GlassProductVersion)' != ''">$(GlassProductVersion)</_GlassProductVersion>
      <_GlassProductVersion Condition="'$(GlassProductVersion)' == ''">2.0.0.0</_GlassProductVersion>
      <_GlassProductBase3>$([System.Text.RegularExpressions.Regex]::Match('$(_GlassProductVersion)', '^\d+\.\d+\.\d+').Value)</_GlassProductBase3>
      <_GlassBundleBuild Condition="'$(GlassBundleBuildNumber)' != ''">$(GlassBundleBuildNumber)</_GlassBundleBuild>
      <_GlassBundleBuild Condition="'$(_GlassBundleBuild)' == ''">0</_GlassBundleBuild>
      <_GlassMsiVersion>$(_GlassProductBase3).$(_GlassBundleBuild)</_GlassMsiVersion>
      <_GlassMsiBundleVersion Condition="'$(GlassBundleVersion)' != ''">$(GlassBundleVersion)</_GlassMsiBundleVersion>
      <_GlassMsiBundleVersion Condition="'$(_GlassMsiBundleVersion)' == ''">$(_GlassMsiVersion)</_GlassMsiBundleVersion>
      <_GlassPlatformTitle Condition="'$(GlassPlatformTitle)' == ''">Glass Platform</_GlassPlatformTitle>
      <_GlassPlatformTitle Condition="'$(GlassPlatformTitle)' != ''">$(GlassPlatformTitle)</_GlassPlatformTitle>
    </PropertyGroup>
    <Error Condition="'$(GlassPayloadArch)' != 'OpenGlass' and '$(GlassBundlePackagingEnabled)' == 'true' and '$(_GlassBundleBuild)' == '0'"
      Text="Glass MSI $(GlassPayloadArch): номер комплекта не задан. Сначала Release|x64 solution, затем x86 с активной сессией." />
    <WriteLinesToFile File="$(GlassProductMetadataWxi)" Overwrite="true" Lines="&lt;?define GlassMsiVersion = &quot;$(_GlassMsiVersion)&quot; ?&gt;" />
    <WriteLinesToFile File="$(GlassProductMetadataWxi)" Lines="&lt;?define GlassMsiBundleVersion = &quot;$(_GlassMsiBundleVersion)&quot; ?&gt;" Overwrite="false" />
    <WriteLinesToFile File="$(GlassProductMetadataWxi)" Lines="&lt;?define GlassUpgradeCode = &quot;$(GlassUpgradeCode)&quot; ?&gt;" Overwrite="false" />
    <WriteLinesToFile File="$(GlassProductMetadataWxi)" Lines="&lt;?define GlassProductCode = &quot;$(GlassProductCode)&quot; ?&gt;" Overwrite="false" />
    <WriteLinesToFile File="$(GlassProductMetadataWxi)" Lines="&lt;?define GlassPlatformTitle = &quot;$(_GlassPlatformTitle)&quot; ?&gt;" Overwrite="false" />
    <WriteLinesToFile File="$(GlassProductMetadataWxi)" Lines="&lt;?define GlassPayloadStage = &quot;$(GlassPayloadStage)&quot; ?&gt;" Overwrite="false" />
    <WriteLinesToFile File="$(GlassProductMetadataWxi)" Lines="&lt;?define GlassUninsExe = &quot;$(GlassUninsExePath)&quot; ?&gt;" Overwrite="false" />
    <WriteLinesToFile File="$(GlassProductMetadataWxi)" Lines="&lt;?define GlassSetupIcon = &quot;$(GlassSetupIconPath)&quot; ?&gt;" Overwrite="false" />
  </Target>

  <Target Name="GlassGenerateHarvest" BeforeTargets="BeforeCompile" DependsOnTargets="GlassWriteProductMetadata" Condition="'$(GlassPayloadArch)' != ''">
    <MakeDir Directories="$(BaseIntermediateOutputPath)" Condition="!Exists('$(BaseIntermediateOutputPath)')" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(GlassPlatformScript)&quot; -MetadataWxi &quot;$(GlassProductMetadataWxi)&quot; -TemplateWxs &quot;$(GlassPlatformTemplate)&quot; -OutWxs &quot;$(GlassPlatformWxs)&quot;" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(GlassHarvestScript)&quot; -StagingDir &quot;$(GlassPayloadStage)&quot; -OutFile &quot;$(GlassHarvestWxs)&quot; -ComponentGroupId &quot;GlassPayloadFiles&quot; -RootDirectoryId &quot;INSTALLDIR&quot;" />
    <ItemGroup>
      <Compile Include="$(GlassPlatformWxs)" />
      <Compile Include="$(GlassHarvestWxs)" />
    </ItemGroup>
  </Target>

  <!-- GlassSetup вшивает MSI из Build\GlassSetup\msi, а WiX пишет в msi\bin. Без этой копии мастер ставит старый пакет. -->
  <Target Name="GlassPublishBuiltMsi" AfterTargets="Build" Condition="'$(GlassPayloadArch)' != ''">
    <PropertyGroup>
      <_GlassMsiPublish Condition="'$(GlassPayloadArch)' == 'x64'">$(SolutionRoot)Build\GlassSetup\msi\$(Configuration)\x64\</_GlassMsiPublish>
      <_GlassMsiPublish Condition="'$(GlassPayloadArch)' == 'x86'">$(SolutionRoot)Build\GlassSetup\msi\$(Configuration)\x86\</_GlassMsiPublish>
      <_GlassMsiPublish Condition="'$(GlassPayloadArch)' == 'OpenGlass'">$(SolutionRoot)Build\GlassSetup\msi\$(Configuration)\OpenGlass\</_GlassMsiPublish>
      <_GlassBuiltMsi Condition="'$(TargetPath)' != '' and Exists('$(TargetPath)')">$(TargetPath)</_GlassBuiltMsi>
      <_GlassBuiltMsi Condition="'$(_GlassBuiltMsi)' == ''">$(OutputPath)$(OutputName).msi</_GlassBuiltMsi>
    </PropertyGroup>
    <Error Condition="!Exists('$(_GlassBuiltMsi)')" Text="Glass MSI was not produced: $(_GlassBuiltMsi)" />
    <MakeDir Directories="$(_GlassMsiPublish)" />
    <Copy SourceFiles="$(_GlassBuiltMsi)" DestinationFolder="$(_GlassMsiPublish)" />
    <Message Importance="high" Text="Published $(_GlassBuiltMsi) -> $(_GlassMsiPublish)" />
    <Exec Condition="'$(GlassPayloadArch)' == 'OpenGlass'"
      Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -Command &quot;$n=(New-Object -ComObject WindowsInstaller.Installer).OpenDatabase('$(_GlassBuiltMsi)',0); $v=$n.OpenView('SELECT Value FROM Property WHERE Property=''ProductName'''); $v.Execute(); if($v.Fetch().StringData(1) -ne 'OpenGlass'){ throw 'OpenGlass-x64.msi has wrong ProductName (WiX obj collision?)' }&quot;" />
  </Target>
</Project>
