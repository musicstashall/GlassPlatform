// Строки деинсталлятора. Сохранять пробелы в префиксах и суффиксах.
LANGUAGE LANG_RUSSIAN, SUBLANG_DEFAULT
STRINGTABLE
BEGIN
  IDS_UNINS_WINDOW_TITLE "GlassPlatform — Удаление"
  IDS_UNINS_SELECT_ALL "Выбрать всё"
  IDS_UNINS_REMOVE "Удалить"
  IDS_UNINS_CLEANUP_CHECK "Удалить настройки и пользовательские данные"
  IDS_UNINS_ERR_TEMP_COPY_CODE "Не удалось подготовить временную копию деинсталлятора. Код: "
  IDS_UNINS_ERR_ALREADY_RUNNING "Другой установщик или деинсталлятор GlassPlatform уже запущен."
  IDS_UNINS_ERR_INITIALIZATION "Неизвестный продукт или ошибка инициализации."
  IDS_UNINS_COMP_BADGE_DEPENDENT "ЗАВИСИМОСТЬ"
  IDS_UNINS_COMP_BADGE_INSTALLED "УСТАНОВЛЕНО"
  IDS_UNINS_COMP_STATE_REMOVE "Будет удалено"
  IDS_UNINS_COMP_STATE_KEEP "Останется без изменений"
  IDS_UNINS_COMP_REASON_CORE_DEPENDENT "удалится вместе с основной платформой"
  IDS_UNINS_COMP_GS64_DESC "Программа настроек оформления, 64-битная версия"
  IDS_UNINS_COMP_GS32_DESC "Программа настроек оформления, 32-битная версия"
  IDS_UNINS_SUT_BADGE_EXTERNAL "ВНЕШНЯЯ УСТАНОВКА"
  IDS_UNINS_SUT_BADGE_RESTART "ПЕРЕЗАПУСК"
  IDS_UNINS_SUT_BADGE_ACTIVE "АКТИВЕН"
  IDS_UNINS_SUT_BADGE_INSTALLED "УСТАНОВЛЕН"
  IDS_UNINS_SUT_STATE_EXTERNAL "Установлен не через GlassPlatform — здесь удалить нельзя"
  IDS_UNINS_SUT_STATE_RESTART "Изменения вступят в силу после перезагрузки"
  IDS_UNINS_SUT_STATE_REMOVE "Будет удалён"
  IDS_UNINS_SUT_STATE_KEEP "Останется без изменений"
  IDS_UNINS_SUT_STATE_INACTIVE "Установлен, сейчас не используется"
  IDS_UNINS_SUT_REASON_DEPENDENT "удалится вместе с GlassSettings"
  IDS_UNINS_SUT_REASON_SEPARATE "можно удалить отдельно"
  IDS_UNINS_SUT_DESC "Позволяет Windows использовать сторонние темы оформления. Установлен в системную папку Windows."
  IDS_UNINS_SUT_LOCK_TITLE "Удаляется вместе с GlassSettings"
  IDS_UNINS_CLEANUP_DESC "Стирает настройки GlassPlatform и сохранённые темы с её оформлением у всех пользователей этого компьютера. Если такая тема сейчас включена, её заменит стандартная тема Windows — у некоторых пользователей после следующего входа в систему. Без этой отметки настройки сохраняются."
  IDS_UNINS_SELECT_TAG "ВЫБОРОЧНОЕ УДАЛЕНИЕ"
  IDS_UNINS_SELECT_TITLE "Выберите продукты для удаления"
  IDS_UNINS_SELECT_INTRO "Будут удалены только отмеченные продукты."
  IDS_UNINS_PROGRESS_TAG "УДАЛЕНИЕ КОМПОНЕНТОВ"
  IDS_UNINS_PROGRESS_TITLE "Удаляем выбранные продукты"
  IDS_UNINS_PROGRESS_BODY "Останавливаем затронутые модули и удаляем выбранные пакеты."
  IDS_UNINS_PROGRESS_SUBSTATUS "Дождитесь окончания операции"
  IDS_UNINS_DONE_TAG "УДАЛЕНИЕ ЗАВЕРШЕНО"
  IDS_UNINS_DONE_WEB_TITLE "Готово"
  IDS_UNINS_DONE_BODY "Выбранные продукты удалены."
  IDS_UNINS_DONE_WARN_TAG "УДАЛЕНИЕ С ПРИМЕЧАНИЕМ"
  IDS_UNINS_DONE_WARN_TITLE "Продукты удалены"
  IDS_UNINS_DONE_WARN_BODY "Данные стёрты. Стандартная тема у части пользователей включится только после следующего входа в систему."
  IDS_UNINS_DONE_WARN_LABEL "СВЕДЕНИЯ ОБ ОЧИСТКЕ"
  IDS_UNINS_DONE_READY "ГОТОВО"
  IDS_UNINS_LOG_HINT "Журнал: %WINDIR%\\Temp\\GlassUninsLogs-*\\GlassUnins.log"
  IDS_UNINS_CANCELLED_TAG "УДАЛЕНИЕ ОТМЕНЕНО"
  IDS_UNINS_CANCELLED_TITLE "Удаление отменено"
  IDS_UNINS_CANCELLED_BODY "Ничего не удалено."
  IDS_UNINS_ERROR_TITLE "Удаление не завершено"
  IDS_UNINS_ERROR_BODY "Подробности приведены ниже."
  IDS_UNINS_THEME_FALLBACK_TITLE "Стандартная тема включится позже"
  IDS_UNINS_THEME_FALLBACK_DETAIL "У некоторых пользователей стандартная тема Windows включится после следующего входа в систему. Если окна выглядят неправильно уже сейчас, выйдите из системы и войдите снова."
  IDS_UNINS_CLOSE "Закрыть"
  IDS_UNINS_MONITOR_RISK_BODY "Для этой проверки нужен GlassSettings подходящей разрядности, но он не установлен или проверка не удалась. Модули Glass могут оставаться загруженными в запущенные программы. Установите подходящий GlassSettings и повторите проверку — или продолжите на свой риск: может понадобиться перезагрузка, а запущенные программы могут работать со сбоями."
  IDS_UNINS_ERR_OG_REMOVE_SEPARATELY "OpenGlass нужно удалять отдельно: не отмечайте вместе с ним другие продукты и очистку данных. Ничего не изменено."
  IDS_UNINS_ERR_OG_LEGACY_INSTALL "Найдена устаревшая установка OpenGlass от предыдущих версий GlassPlatform. Удалите её деинсталлятором той версии, затем повторите. Ничего не изменено."
  IDS_UNINS_ERR_OG_INSTALL_CHANGED "OpenGlass не найден или изменился после запуска деинсталлятора. Удаление не начато — запустите деинсталлятор заново. "
  IDS_UNINS_STATUS_OG_REMOVE "Удаление OpenGlass…"
  IDS_UNINS_ERR_OG_REMOVE_UNVERIFIED "Не удалось убедиться, что OpenGlass удалён: удаление могло пройти частично, и прежнее состояние не восстановлено. Перезагрузите компьютер и запустите деинсталлятор снова. "
  IDS_UNINS_STATUS_OG_DONE_RESTART "OpenGlass удалён. Требуется перезагрузка Windows."
  IDS_UNINS_STATUS_OG_DONE_SETTINGS_KEPT "OpenGlass удалён. Его настройки сохранены на случай повторной установки."
  IDS_UNINS_ERR_CLEANUP_REVIEW_REQUIRED "Очистку данных можно включить только при удалении всех продуктов, отметив её на отдельной странице. Ничего не изменено."
  IDS_UNINS_ERR_INSTALL_ROOTS_CHANGED "Папки установленных продуктов изменились или не найдены. Ничего не удалено — запустите деинсталлятор заново."
  IDS_UNINS_ERR_SUT_THEME_PREPARE "SecureUxTheme не удалён: не удалось подготовить возврат стандартной темы у всех пользователей. "
  IDS_UNINS_ERR_CLEANUP_PROFILE_ACCESS "Не удалось получить доступ к данным всех пользователей. Попросите других пользователей выйти из системы и повторите. Подробности: "
  IDS_UNINS_ERR_OG_FILE_OWNERSHIP "Не удалось подтвердить владение файлами OpenGlass. Удаление остановлено."
  IDS_UNINS_STATUS_CHECK_PATHS "Проверка путей установленных продуктов…"
  IDS_UNINS_ERR_PREPARE_PATH_CHECK "Не удалось подготовить проверку установленных продуктов. Ничего не удалено."
  IDS_UNINS_ERR_PRODUCT_PATH_UNVERIFIED "Не удалось убедиться, что установленный продукт находится там, где ожидается. Удаление остановлено, ничего не изменено. Сохраните журнал и обратитесь за помощью; не удаляйте файлы вручную."
  IDS_UNINS_ERR_PRODUCT_CHANGED_DURING_REMOVAL "Сведения об установленном продукте изменились во время удаления; часть продуктов могла уже быть удалена. Сохраните журнал и обратитесь за помощью; не удаляйте файлы вручную."
  IDS_UNINS_ERR_PLAN_CHANGED "План удаления больше нельзя безопасно выполнить. Продукты не изменены; откройте обслуживание повторно."
  IDS_UNINS_ERR_PREPARE_SETTINGS_SHORTCUT "Не удалось безопасно подготовить ярлык оставшегося Settings. Ничего не удалено. "
  IDS_UNINS_ERR_PREPARE_SHELL_HELPER "Не удалось подготовить компонент регистрации оболочки для выбранного пути. Ничего не удалено."
  IDS_UNINS_ERR_PLATFORM_STATE "Не удалось проверить состояние платформы. Ничего не удалено."
  IDS_UNINS_ERR_PLATFORM_RESTORE_UNSAFE "Работающую платформу невозможно безопасно восстановить. Остановите её и повторите удаление."
  IDS_UNINS_ERR_OG_STATE "Не удалось проверить состояние OpenGlass. Ничего не удалено."
  IDS_UNINS_ERR_OG_RESTORE_UNSAFE "Нельзя безопасно восстановить текущее состояние OpenGlass. Остановите OpenGlass и повторите удаление."
  IDS_UNINS_ERR_RESTART_STOPPED_MODULES "Ничего не удалено, но остановленные модули Glass не удалось запустить снова. Перезагрузите компьютер."
  IDS_UNINS_STATUS_STOP_COMPONENTS "Остановка компонентов…"
  IDS_UNINS_ERR_STOP_OR_RESTORE_COMPONENTS "Не удалось остановить компоненты или восстановить их прежнее состояние. Ничего не удалено."
  IDS_UNINS_ERR_STOP_COMPONENTS "Не удалось остановить компоненты. Ничего не удалено."
  IDS_UNINS_STATUS_CHECK_MODULES "Проверка модулей в процессах…"
  IDS_UNINS_ERR_KEPT_SETTINGS_STATE_CHANGED "Состояние сохраняемого Settings изменилось. Ничего не удалено. "
  IDS_UNINS_ERR_COMMIT_SETTINGS_SHORTCUT "Не удалось переназначить ярлык Settings. Ничего не удалено. "
  IDS_UNINS_ERR_SUT_PROFILE_STATE_CHANGED "SecureUxTheme сохранён: состояние профилей изменилось. "
  IDS_UNINS_STATUS_DEACTIVATE_SUT "Отключение SecureUxTheme…"
  IDS_UNINS_ERR_DEACTIVATE_SUT "Не удалось отключить SecureUxTheme. Ничего не удалено."
  IDS_UNINS_STATUS_REMOVE_PRODUCT_PREFIX "Удаление "
  IDS_UNINS_ERR_KEPT_SETTINGS_REGISTRATION_CHANGED "Регистрация сохраняемого Settings изменилась во время удаления. "
  IDS_UNINS_ERR_REMOVE_PACKAGE_PREFIX "Не удалось удалить пакет: "
  IDS_UNINS_ERR_UNREGISTER_SHELL_EXTENSION "Не удалось снять регистрацию расширения оболочки. Некоторые выбранные продукты могли уже быть удалены."
  IDS_UNINS_ERR_OG_OUT_OF_MEMORY "Недостаточно памяти для удаления OpenGlass."
  IDS_UNINS_ERR_OG_REMOVE_FILES "Не удалось удалить файлы OpenGlass: "
  IDS_UNINS_ERR_OG_SERVICE_TASK_CHANGED "Служба или задача OpenGlass изменилась и не будет удалена. Выполняется восстановление доступного состояния."
  IDS_UNINS_ERR_OG_REMOVE_SERVICE_TASK "OpenGlass удалён, но служба или задача не удалена."
  IDS_UNINS_ERR_REMOVE_PLATFORM_X86_TASK "Платформа x86 удалена, но задача автозапуска не удалена."
  IDS_UNINS_ERR_REMOVE_PLATFORM_X64_TASK "Платформа x64 удалена, но задача автозапуска не удалена."
  IDS_UNINS_ERR_REFRESH_REMAINING_PRODUCTS "Выбранные продукты удалены, но не удалось обновить сведения об оставшихся продуктах в списке «Установленные приложения» Windows. Подробности — в журнале."
  IDS_UNINS_ERR_PRODUCTS_STILL_REGISTERED "Удаление обработано, но продукты ещё зарегистрированы. Глобальная очистка не выполнялась."
  IDS_UNINS_STATUS_REMOVE_SETTINGS "Удаление настроек…"
  IDS_UNINS_ERR_SETTINGS_CLEANUP_INCOMPLETE "Продукты обработаны, но очистка настроек завершена не полностью: "
  IDS_UNINS_ERR_RESTART_REMAINING_COMPONENTS "Выбранные продукты удалены, но не удалось перезапустить оставшиеся компоненты."
  IDS_UNINS_STATUS_DONE "Удаление завершено."
  IDS_UNINS_STATUS_DONE_THEME_FALLBACK_SUFFIX " У некоторых пользователей стандартная тема Windows включится после следующего входа в систему."
  IDS_UNINS_STATUS_DONE_SUT_RESTART_SUFFIX " Перезагрузите компьютер, чтобы завершить удаление SecureUxTheme."
  IDS_UNINS_STATUS_DONE_SUT_DEACTIVATED_SUFFIX " Сторонняя тема оформления отключена: после перезагрузки будет использоваться стандартная тема Windows."
  IDS_UNINS_ERR_RESTORE_SETTINGS_SHORTCUT "Не удалось завершить восстановление или проверку ярлыка Settings. Сохранены данные восстановления: "
  IDS_UNINS_ERR_START_REMOVAL "Не удалось запустить удаление."
  IDS_UNINS_CLEANUP_TITLE "Очистка данных (по желанию)"
  IDS_UNINS_HOLD_MODULES_TITLE "Модули Glass заняты программами"
  IDS_UNINS_DONE_NATIVE_TITLE "Удаление завершено"
  IDS_UNINS_PROGRESS_NATIVE_TITLE "Удаление компонентов…"
  IDS_UNINS_CLEANUP_NATIVE_BODY "Все выбранные продукты будут удалены. Ваши настройки по умолчанию сохраняются. Если включить очистку, то после удаления продуктов будут стёрты и настройки GlassPlatform во всех профилях этого компьютера."
END
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
STRINGTABLE
BEGIN
  IDS_UNINS_WINDOW_TITLE "GlassPlatform — Uninstall"
  IDS_UNINS_SELECT_ALL "Select all"
  IDS_UNINS_REMOVE "Remove"
  IDS_UNINS_CLEANUP_CHECK "Remove settings and user data"
  IDS_UNINS_ERR_TEMP_COPY_CODE "Could not prepare the temporary uninstaller. Code: "
  IDS_UNINS_ERR_ALREADY_RUNNING "Another GlassPlatform setup or uninstaller is already running."
  IDS_UNINS_ERR_INITIALIZATION "Unknown product or initialization error."
  IDS_UNINS_COMP_BADGE_DEPENDENT "DEPENDENT"
  IDS_UNINS_COMP_BADGE_INSTALLED "INSTALLED"
  IDS_UNINS_COMP_STATE_REMOVE "Will be removed"
  IDS_UNINS_COMP_STATE_KEEP "Will be kept as is"
  IDS_UNINS_COMP_REASON_CORE_DEPENDENT "removed together with the core platform"
  IDS_UNINS_COMP_GS64_DESC "Styling settings app, 64-bit version"
  IDS_UNINS_COMP_GS32_DESC "Styling settings app, 32-bit version"
  IDS_UNINS_SUT_BADGE_EXTERNAL "EXTERNAL INSTALL"
  IDS_UNINS_SUT_BADGE_RESTART "RESTART PENDING"
  IDS_UNINS_SUT_BADGE_ACTIVE "ACTIVE"
  IDS_UNINS_SUT_BADGE_INSTALLED "INSTALLED"
  IDS_UNINS_SUT_STATE_EXTERNAL "Not installed by GlassPlatform — can't be removed here"
  IDS_UNINS_SUT_STATE_RESTART "Changes take effect after a restart"
  IDS_UNINS_SUT_STATE_REMOVE "Will be removed"
  IDS_UNINS_SUT_STATE_KEEP "Will remain unchanged"
  IDS_UNINS_SUT_STATE_INACTIVE "Installed, not in use right now"
  IDS_UNINS_SUT_REASON_DEPENDENT "removed with GlassSettings"
  IDS_UNINS_SUT_REASON_SEPARATE "can be removed separately"
  IDS_UNINS_SUT_DESC "Lets Windows use third-party visual styles. Installed in the Windows system folder."
  IDS_UNINS_SUT_LOCK_TITLE "Removed with GlassSettings"
  IDS_UNINS_CLEANUP_DESC "Erases GlassPlatform settings and saved themes that use its styling for every user on this computer. If such a theme is on, the standard Windows theme replaces it — for some users after their next sign-in. Without this option, settings are kept."
  IDS_UNINS_SELECT_TAG "SELECTIVE UNINSTALL"
  IDS_UNINS_SELECT_TITLE "Select products to remove"
  IDS_UNINS_SELECT_INTRO "Only selected products will be removed."
  IDS_UNINS_PROGRESS_TAG "UNINSTALLING COMPONENTS"
  IDS_UNINS_PROGRESS_TITLE "Removing selected products"
  IDS_UNINS_PROGRESS_BODY "Stopping affected modules and removing the selected packages."
  IDS_UNINS_PROGRESS_SUBSTATUS "Please wait for the operation to finish"
  IDS_UNINS_DONE_TAG "UNINSTALL COMPLETE"
  IDS_UNINS_DONE_WEB_TITLE "Finished"
  IDS_UNINS_DONE_BODY "The selected products have been removed."
  IDS_UNINS_DONE_WARN_TAG "REMOVAL WITH A NOTE"
  IDS_UNINS_DONE_WARN_TITLE "Products removed"
  IDS_UNINS_DONE_WARN_BODY "Data erased. For some users, the standard theme turns on only after their next sign-in."
  IDS_UNINS_DONE_WARN_LABEL "CLEANUP DETAILS"
  IDS_UNINS_DONE_READY "DONE"
  IDS_UNINS_LOG_HINT "Log: %WINDIR%\\Temp\\GlassUninsLogs-*\\GlassUnins.log"
  IDS_UNINS_CANCELLED_TAG "UNINSTALL CANCELLED"
  IDS_UNINS_CANCELLED_TITLE "Uninstall cancelled"
  IDS_UNINS_CANCELLED_BODY "Nothing was removed."
  IDS_UNINS_ERROR_TITLE "Uninstall did not finish"
  IDS_UNINS_ERROR_BODY "Details are shown below."
  IDS_UNINS_THEME_FALLBACK_TITLE "The standard theme will turn on later"
  IDS_UNINS_THEME_FALLBACK_DETAIL "For some users, the standard Windows theme turns on after their next sign-in. If windows look wrong right now, sign out and sign back in."
  IDS_UNINS_CLOSE "Close"
  IDS_UNINS_MONITOR_RISK_BODY "This check needs GlassSettings of the matching bitness, but it isn't installed or the check failed. Glass modules may still be loaded in running applications. Install the matching GlassSettings and retry — or continue at your own risk: a restart may be needed, and running applications may malfunction."
  IDS_UNINS_ERR_OG_REMOVE_SEPARATELY "OpenGlass must be removed on its own: don't select other products or data cleanup together with it. Nothing was changed."
  IDS_UNINS_ERR_OG_LEGACY_INSTALL "An outdated OpenGlass installation from earlier GlassPlatform versions was found. Remove it with that version's uninstaller, then try again. Nothing was changed."
  IDS_UNINS_ERR_OG_INSTALL_CHANGED "OpenGlass was not found or changed after the uninstaller started. Removal was not started — run the uninstaller again. "
  IDS_UNINS_STATUS_OG_REMOVE "Removing OpenGlass…"
  IDS_UNINS_ERR_OG_REMOVE_UNVERIFIED "Couldn't confirm that OpenGlass was removed: removal may be partial, and the previous state was not restored. Restart the computer and run the uninstaller again. "
  IDS_UNINS_STATUS_OG_DONE_RESTART "OpenGlass removed. Restart Windows to finish."
  IDS_UNINS_STATUS_OG_DONE_SETTINGS_KEPT "OpenGlass removed. Its settings are kept in case you reinstall it."
  IDS_UNINS_ERR_CLEANUP_REVIEW_REQUIRED "Data cleanup can be turned on only when removing all products, by selecting it on its own page. Nothing was changed."
  IDS_UNINS_ERR_INSTALL_ROOTS_CHANGED "Folders of installed products changed or were not found. Nothing was removed — run the uninstaller again."
  IDS_UNINS_ERR_SUT_THEME_PREPARE "SecureUxTheme was not removed: couldn't prepare switching every user back to the standard theme. "
  IDS_UNINS_ERR_CLEANUP_PROFILE_ACCESS "Couldn't access every user's data. Ask other users to sign out and try again. Details: "
  IDS_UNINS_ERR_OG_FILE_OWNERSHIP "OpenGlass file ownership could not be verified. Removal stopped."
  IDS_UNINS_STATUS_CHECK_PATHS "Checking installed product paths…"
  IDS_UNINS_ERR_PREPARE_PATH_CHECK "Could not prepare the check of installed products. Nothing was removed."
  IDS_UNINS_ERR_PRODUCT_PATH_UNVERIFIED "Couldn't confirm that an installed product is where it is expected to be. Removal stopped; nothing was changed. Save the log and ask for help; do not delete files manually."
  IDS_UNINS_ERR_PRODUCT_CHANGED_DURING_REMOVAL "Information about an installed product changed during removal; some products may already have been removed. Save the log and ask for help; do not delete files manually."
  IDS_UNINS_ERR_PLAN_CHANGED "The removal plan is no longer safe to execute. Products were not changed; reopen maintenance."
  IDS_UNINS_ERR_PREPARE_SETTINGS_SHORTCUT "Could not safely prepare the retained Settings shortcut. Nothing was removed. "
  IDS_UNINS_ERR_PREPARE_SHELL_HELPER "Could not prepare the shell registration component for the selected path. Nothing was removed."
  IDS_UNINS_ERR_PLATFORM_STATE "Could not inspect the platform state. Nothing was removed."
  IDS_UNINS_ERR_PLATFORM_RESTORE_UNSAFE "The running platform cannot be restored safely. Stop it and retry removal."
  IDS_UNINS_ERR_OG_STATE "Could not inspect OpenGlass. Nothing was removed."
  IDS_UNINS_ERR_OG_RESTORE_UNSAFE "The current OpenGlass state cannot be safely restored. Stop OpenGlass and retry removal."
  IDS_UNINS_ERR_RESTART_STOPPED_MODULES "Nothing was removed, but the stopped Glass modules could not be started again. Restart the computer."
  IDS_UNINS_STATUS_STOP_COMPONENTS "Stopping components…"
  IDS_UNINS_ERR_STOP_OR_RESTORE_COMPONENTS "Could not stop components or restore their previous state. Nothing was removed."
  IDS_UNINS_ERR_STOP_COMPONENTS "Could not stop components. Nothing was removed."
  IDS_UNINS_STATUS_CHECK_MODULES "Checking modules in processes…"
  IDS_UNINS_ERR_KEPT_SETTINGS_STATE_CHANGED "The retained Settings state changed. Nothing was removed. "
  IDS_UNINS_ERR_COMMIT_SETTINGS_SHORTCUT "Could not retarget the Settings shortcut. Nothing was removed. "
  IDS_UNINS_ERR_SUT_PROFILE_STATE_CHANGED "SecureUxTheme retained: profile state changed. "
  IDS_UNINS_STATUS_DEACTIVATE_SUT "Deactivating SecureUxTheme…"
  IDS_UNINS_ERR_DEACTIVATE_SUT "Could not deactivate SecureUxTheme. Nothing was removed."
  IDS_UNINS_STATUS_REMOVE_PRODUCT_PREFIX "Removing "
  IDS_UNINS_ERR_KEPT_SETTINGS_REGISTRATION_CHANGED "The retained Settings registration changed during removal. "
  IDS_UNINS_ERR_REMOVE_PACKAGE_PREFIX "Could not remove package: "
  IDS_UNINS_ERR_UNREGISTER_SHELL_EXTENSION "Could not unregister the shell extension. Some selected products may already have been removed."
