// Общие RU/EN-ресурсы Setup и Unins. Сохранять ведущий пробел в суффиксе.
LANGUAGE LANG_RUSSIAN, SUBLANG_DEFAULT
STRINGTABLE
BEGIN
  IDS_BRAND "GlassPlatform"
  IDS_BACK "Назад"
  IDS_CANCEL "Отмена"
  IDS_ERROR_TAG "ОШИБКА"
  IDS_ERROR_DETAILS "ДЕТАЛИ"
  IDS_COPY "Копировать"
  IDS_HOLD_RETRY "Повторить"
  IDS_KILL_TITLE "Процессы удерживают модули"
  IDS_UNLOCK "Разблокировать"
  IDS_COMP_P64_TITLE "Glass Platform x64"
  IDS_COMP_P64_DESC "Оформление 64-битных приложений"
  IDS_COMP_P32_TITLE "Glass Platform x86"
  IDS_COMP_P32_DESC "Оформление 32-битных приложений"
  IDS_COMP_OG_TITLE "OpenGlass"
  IDS_COMP_OG_DESC "Классические стеклянные рамки окон в стиле Aero Glass."
  IDS_COMP_SUT_TITLE "SecureUxTheme"
  IDS_COMP_GS64_TITLE "GlassSettings x64"
  IDS_COMP_GS32_TITLE "GlassSettings x86"
  IDS_NATIVE_RISK_TITLE "Не удалось проверить, освобождены ли модули Glass"
  IDS_CONTINUE_RISK "Продолжить на свой риск"
  IDS_COMP_SHELL_SUFFIX " и оболочки Windows"
  IDS_PLAN_WARN_NO_HELPER64 "Platform x64 останется без GlassSettings x64. Тогда при обновлении или удалении Platform x64 её не удастся безопасно отключить от запущенных программ: может понадобиться перезагрузка, иначе возможны сбои программ. Рекомендуем установить или оставить GlassSettings x64 — версия x86 его не заменяет."
  IDS_PLAN_WARN_NO_HELPER32 "Platform x86 останется без GlassSettings x86. Тогда при обновлении или удалении Platform x86 её не удастся безопасно отключить от запущенных программ: может понадобиться перезагрузка, иначе возможны сбои программ. Рекомендуем установить или оставить GlassSettings x86 — версия x64 его не заменяет."
  IDS_PLAN_WARN_MANUAL_SETTINGS "Без GlassSettings не останется программы настроек: включать, выключать и настраивать оформление придётся вручную, через реестр Windows."
  IDS_PLAN_WARN_MANUAL_OPENGLASS "Без GlassSettings OpenGlass придётся включать, выключать и настраивать вручную."
  IDS_PLAN_WARN_MANUAL_VISUAL_STYLES "SecureUxTheme останется без GlassSettings. Темы оформления придётся переключать вручную, иногда с перезапуском Windows. Перед удалением SecureUxTheme сначала верните стандартную тему Windows."
  IDS_PLAN_WARN_DAMAGE_RETAINED "Этот продукт повреждён и не будет исправлен."
  IDS_PLAN_WARN_NO_PLATFORM64 "Без Platform x64 не будет оформления 64-битных приложений"
  IDS_PLAN_WARN_NO_PLATFORM32 "Без Platform x86 не будет оформления 32-битных приложений"
  IDS_PLAN_WARN_NO_PLATFORM_SUFFIX ". Остальные продукты от этого не зависят."
END
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
STRINGTABLE
BEGIN
  IDS_BRAND "GlassPlatform"
  IDS_BACK "Back"
  IDS_CANCEL "Cancel"
  IDS_ERROR_TAG "ERROR"
  IDS_ERROR_DETAILS "DETAILS"
  IDS_COPY "Copy"
  IDS_HOLD_RETRY "Retry"
  IDS_KILL_TITLE "Processes are holding modules"
  IDS_UNLOCK "Unlock"
  IDS_COMP_P64_TITLE "Glass Platform x64"
  IDS_COMP_P64_DESC "Styling for 64-bit applications"
  IDS_COMP_P32_TITLE "Glass Platform x86"
  IDS_COMP_P32_DESC "Styling for 32-bit applications"
  IDS_COMP_OG_TITLE "OpenGlass"
  IDS_COMP_OG_DESC "Classic Aero Glass-style glass window frames."
  IDS_COMP_SUT_TITLE "SecureUxTheme"
  IDS_COMP_GS64_TITLE "GlassSettings x64"
  IDS_COMP_GS32_TITLE "GlassSettings x86"
  IDS_NATIVE_RISK_TITLE "Couldn't confirm that Glass modules are released"
  IDS_CONTINUE_RISK "Continue at risk"
  IDS_COMP_SHELL_SUFFIX " and the Windows shell"
  IDS_PLAN_WARN_NO_HELPER64 "Platform x64 will be left without GlassSettings x64. When Platform x64 is later updated or removed, it can't be safely detached from running applications: a restart may be needed, otherwise applications may crash. We recommend installing or keeping GlassSettings x64 — the x86 version doesn't replace it."
  IDS_PLAN_WARN_NO_HELPER32 "Platform x86 will be left without GlassSettings x86. When Platform x86 is later updated or removed, it can't be safely detached from running applications: a restart may be needed, otherwise applications may crash. We recommend installing or keeping GlassSettings x86 — the x64 version doesn't replace it."
  IDS_PLAN_WARN_MANUAL_SETTINGS "Without GlassSettings there is no settings app: styling has to be turned on, off and adjusted manually in the Windows registry."
  IDS_PLAN_WARN_MANUAL_OPENGLASS "Without GlassSettings, OpenGlass has to be turned on, off and adjusted manually."
  IDS_PLAN_WARN_MANUAL_VISUAL_STYLES "SecureUxTheme will be left without GlassSettings. Visual styles will have to be switched manually, sometimes with a Windows restart. Before removing SecureUxTheme, switch back to the standard Windows theme first."
  IDS_PLAN_WARN_DAMAGE_RETAINED "This product is damaged and will not be repaired."
  IDS_PLAN_WARN_NO_PLATFORM64 "Without Platform x64, styling is unavailable for 64-bit applications"
  IDS_PLAN_WARN_NO_PLATFORM32 "Without Platform x86, styling is unavailable for 32-bit applications"
  IDS_PLAN_WARN_NO_PLATFORM_SUFFIX ". Other products don't depend on it."
END
