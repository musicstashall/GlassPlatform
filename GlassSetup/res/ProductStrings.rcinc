// Shared by Setup and Unins. Keep the leading space when concatenating.
LANGUAGE LANG_RUSSIAN, SUBLANG_DEFAULT
STRINGTABLE
BEGIN
  IDS_APPLY "Применить"
  IDS_INSTALL_TITLE "Установка GlassPlatform"
  IDS_MAINTENANCE_TITLE "Обслуживание GlassPlatform"
  IDS_COMP_GS64_TITLE "GlassSettings x64"
  IDS_COMP_GS32_TITLE "GlassSettings x86"
  IDS_INSPECT_UNAVAILABLE "Не удалось проверить целостность: нет данных об исходной установке продукта"
  IDS_NATIVE_RISK_TITLE "Не удалось проверить, освобождены ли модули Glass"
  IDS_NATIVE_RISK_BODY "Для этой проверки нужен GlassSettings подходящей разрядности, но он не установлен или проверка не удалась. Модули Glass могут оставаться загруженными в запущенные программы. Установите подходящий GlassSettings и повторите проверку — или продолжите на свой риск: может понадобиться перезагрузка, а запущенные программы могут работать со сбоями."
  IDS_CONTINUE_RISK "Продолжить на свой риск"
  IDS_COMP_SHELL_SUFFIX " и оболочки Windows"
END
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
STRINGTABLE
BEGIN
  IDS_APPLY "Apply"
  IDS_INSTALL_TITLE "Install GlassPlatform"
  IDS_MAINTENANCE_TITLE "Maintain GlassPlatform"
  IDS_COMP_GS64_TITLE "GlassSettings x64"
  IDS_COMP_GS32_TITLE "GlassSettings x86"
  IDS_INSPECT_UNAVAILABLE "Integrity couldn't be checked: no information about the product's original installation"
  IDS_NATIVE_RISK_TITLE "Couldn't confirm that Glass modules are released"
  IDS_NATIVE_RISK_BODY "This check needs GlassSettings of the matching bitness, but it isn't installed or the check failed. Glass modules may still be loaded in running applications. Install the matching GlassSettings and check again — or continue at your own risk: a restart may be needed, and running applications may misbehave."
  IDS_CONTINUE_RISK "Continue at risk"
  IDS_COMP_SHELL_SUFFIX " and the Windows shell"
END
