LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
1 RT_MANIFEST "app.manifest"
IDI_APP ICON "app.ico"
IDR_HTML RCDATA "slideshow.html"
IDR_WELCOME RCDATA "welcome_banner.png"
IDR_GPL RCDATA "GPL-3.0.txt"
LANGUAGE LANG_RUSSIAN, SUBLANG_DEFAULT
IDR_EULA RCDATA "Eula.ru.txt"
STRINGTABLE
BEGIN
  IDS_BRAND "GlassPlatform"
  IDS_TITLE "GlassPlatform — Установка"
  IDS_BACK "Назад"
  IDS_NEXT "Далее"
  IDS_INSTALL "Установить"
  IDS_CANCEL "Отмена"
  IDS_FINISH "Готово"
  IDS_WELCOME_TITLE "Ваш Windows.\nНовое измерение."
  IDS_WELCOME_BODY "Добро пожаловать в мастер установки GlassPlatform. Настройте знакомый интерфейс Windows по-своему."
  IDS_WELCOME_NOTE "Для продолжения нажмите «Далее»."
  IDS_WELCOME_TAG "ДОБРО ПОЖАЛОВАТЬ"
  IDS_EULA_TITLE "Лицензионное соглашение"
  IDS_EULA_BODY "Прочитайте условия использования перед продолжением."
  IDS_ACCEPT "Я принимаю условия лицензионного соглашения"
  IDS_STATUS_PREPARE "Подготовка компонентов…"
  IDS_STATUS_FILES "Копирование файлов…"
  IDS_STATUS_CONFIG "Настройка интерфейса…"
  IDS_STATUS_FINAL "Завершение установки…"
  IDS_SIMULATION_NOTE "Демонстрация: установка имитируется в течение 30 секунд."
  IDS_DONE_TITLE "Всё готово!"
  IDS_DONE_BODY "GlassPlatform установлена и запущена."
  IDS_DONE_NOTE "Мастер можно закрыть. Журнал — GlassSetup.log рядом с этой программой."
  IDS_DONE_TAG "ГОТОВО"
  IDS_CONFIRM_CANCEL "Прервать установку и закрыть мастер?"
  IDS_RUNTIME_MISSING "Для отображения встроенных слайдов требуется Microsoft Edge WebView2 Runtime. Установите Evergreen Runtime (x86) и запустите мастер снова.\n\nhttps://developer.microsoft.com/microsoft-edge/webview2/"
  IDS_WEB_ERROR "Не удалось запустить встроенный HTML. Код ошибки: "
  IDS_WEB_LOADING "Подготовка слайдов…"
  IDS_APP_INIT_ERROR "Не удалось создать окно установщика."
  IDS_GPL_APPENDIX "Приложение: GNU General Public License, версия 3 (оригинал)"
  IDS_COM_ERROR "Не удалось инициализировать COM."
  IDS_UPDATE_NEWER "Доступна более новая версия установщика.\n\nТекущая: {0}\nНа GitHub: {1}\n\nОткрыть страницу загрузки?"
  IDS_ERROR_TAG "ОШИБКА"
  IDS_ERROR_TITLE "Установка не выполнена"
  IDS_ERROR_BODY "Не удалось завершить установку. Ниже указана возможная причина."
  IDS_ERROR_LOG_HINT "Подробности — в файле GlassSetup.log в каталоге установщика."
  IDS_ERR_INSTALL_PATH "Не удалось определить каталог Program Files для установки."
  IDS_ERR_INSTALL_FAILED "Один из шагов установки завершился с ошибкой."
  IDS_STATUS_EXTRACT "Подготовка пакетов…"
  IDS_STATUS_X64 "Установка платформы (64-бит)…"
  IDS_STATUS_X86 "Установка платформы (32-бит)…"
  IDS_STATUS_OG "Установка OpenGlass…"
  IDS_STATUS_STOP64 "Остановка платформы (64-бит)…"
  IDS_STATUS_STOP86 "Остановка платформы (32-бит)…"
  IDS_STATUS_STOPOG "Остановка OpenGlass…"
  IDS_UPDATE_TITLE "Доступна новая версия"
  IDS_UPDATE_BODY "Эта копия: {0}\nНа GitHub: {1}\n\nМожно открыть страницу релиза или продолжить установку этой версии."
  IDS_UPDATE_DOWNLOAD "Загрузить"
  IDS_UPDATE_SKIP "Пропустить"
  IDS_HOLD_TITLE "Остановка платформы"
  IDS_HOLD_BODY "Платформа остановлена, но эти модули всё ещё заняты процессами. «Повторить» снимет их принудительно — так же, как выгрузка в GlassSettings."
  IDS_HOLD_RETRY "Повторить"
  IDS_KILL_TITLE "Процессы удерживают модули"
  IDS_KILL_BODY "Принудительная выгрузка не помогла. «Разблокировать» закроет эти процессы, а если они не завершатся — остановит их принудительно. «Отмена» отключит автозапуск (задачи и службу, без удаления): после перезагрузки платформа не стартует."
  IDS_UNLOCK "Разблокировать"
  IDS_STATUS_UNLOAD "Проверка модулей в процессах…"
  IDS_STATUS_START64 "Запуск платформы (64-бит)…"
  IDS_STATUS_START86 "Запуск платформы (32-бит)…"
  IDS_STATUS_STARTOG "Запуск OpenGlass…"
  IDS_DONE_BODY_DEMO "Демонстрация установки завершена. Файлы платформы не изменялись."
  IDS_DONE_NOTE_DEMO "Это сборка Debug: установка имитируется, параметры Windows не меняются."
END
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
IDR_EULA RCDATA "Eula.en.txt"
STRINGTABLE
BEGIN
  IDS_BRAND "GlassPlatform"
  IDS_TITLE "GlassPlatform — Setup"
  IDS_BACK "Back"
  IDS_NEXT "Next"
  IDS_INSTALL "Install"
  IDS_CANCEL "Cancel"
  IDS_FINISH "Finish"
  IDS_WELCOME_TITLE "Your Windows.\nA new dimension."
  IDS_WELCOME_BODY "Welcome to GlassPlatform Setup. Make the familiar Windows interface your own."
  IDS_WELCOME_NOTE "Select Next to continue."
  IDS_WELCOME_TAG "WELCOME"
  IDS_EULA_TITLE "License agreement"
  IDS_EULA_BODY "Please read the terms before continuing."
  IDS_ACCEPT "I accept the terms of the license agreement"
  IDS_STATUS_PREPARE "Preparing components…"
  IDS_STATUS_FILES "Copying files…"
  IDS_STATUS_CONFIG "Configuring the interface…"
  IDS_STATUS_FINAL "Finalizing setup…"
  IDS_SIMULATION_NOTE "Demo: installation is simulated for 30 seconds."
  IDS_DONE_TITLE "You’re all set!"
  IDS_DONE_BODY "GlassPlatform is installed and running."
  IDS_DONE_NOTE "You can close the wizard. The setup log is GlassSetup.log next to this program."
  IDS_DONE_TAG "DONE"
  IDS_CONFIRM_CANCEL "Cancel the installation and close the wizard?"
  IDS_RUNTIME_MISSING "Microsoft Edge WebView2 Runtime is required to show the embedded slides. Install the x86 Evergreen Runtime and run Setup again.\n\nhttps://developer.microsoft.com/microsoft-edge/webview2/"
  IDS_WEB_ERROR "Could not initialize the embedded HTML. Error code: "
  IDS_WEB_LOADING "Preparing slides…"
  IDS_APP_INIT_ERROR "Could not create the setup window."
  IDS_GPL_APPENDIX "Appendix: GNU General Public License, version 3 (original)"
  IDS_COM_ERROR "Could not initialize COM."
  IDS_UPDATE_NEWER "A newer setup is available.\n\nThis copy: {0}\nOn GitHub: {1}\n\nOpen the download page?"
  IDS_ERROR_TAG "ERROR"
  IDS_ERROR_TITLE "Setup could not finish"
  IDS_ERROR_BODY "Installation did not complete. A possible reason is shown below."
  IDS_ERROR_LOG_HINT "See GlassSetup.log in the folder that contains this setup program."
  IDS_ERR_INSTALL_PATH "Could not resolve the Program Files folder for installation."
  IDS_ERR_INSTALL_FAILED "A setup step returned an error."
  IDS_STATUS_EXTRACT "Preparing packages…"
  IDS_STATUS_X64 "Installing the 64-bit platform…"
  IDS_STATUS_X86 "Installing the 32-bit platform…"
  IDS_STATUS_OG "Installing OpenGlass…"
  IDS_STATUS_STOP64 "Stopping the 64-bit platform…"
  IDS_STATUS_STOP86 "Stopping the 32-bit platform…"
  IDS_STATUS_STOPOG "Stopping OpenGlass…"
  IDS_UPDATE_TITLE "A newer version is available"
  IDS_UPDATE_BODY "This copy: {0}\nOn GitHub: {1}\n\nOpen the release page, or continue with this version."
  IDS_UPDATE_DOWNLOAD "Download"
  IDS_UPDATE_SKIP "Skip"
  IDS_HOLD_TITLE "Stopping the platform"
  IDS_HOLD_BODY "The platform has stopped, but these modules are still held by processes. Retry force-unloads them the same way GlassSettings does."
  IDS_HOLD_RETRY "Retry"
  IDS_KILL_TITLE "Processes are holding modules"
  IDS_KILL_BODY "Force-unload did not release them. Unlock closes these processes and terminates any that stay running. Cancel disables autostart (tasks and the service are not deleted), so the platform will not start after a reboot."
  IDS_UNLOCK "Unlock"
  IDS_STATUS_UNLOAD "Checking modules in processes…"
  IDS_STATUS_START64 "Starting the 64-bit platform…"
  IDS_STATUS_START86 "Starting the 32-bit platform…"
  IDS_STATUS_STARTOG "Starting OpenGlass…"
  IDS_DONE_BODY_DEMO "The setup demonstration is complete. Platform files were not changed."
  IDS_DONE_NOTE_DEMO "This is a Debug build: installation is simulated and Windows settings are not changed."
END
