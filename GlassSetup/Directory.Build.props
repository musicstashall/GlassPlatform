<Project>
  <!-- MSBuild подхватывает только ближайший Directory.Build.props — тянем корень репо (GlassProductVersion и т.д.). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" Condition="'$(GlassProductVersion)' == ''" />

  <!-- Собственный FileVersion; ProductVersion комплекта — из GlassBundleBuild.targets / Directory.Build.targets. -->
  <PropertyGroup>
    <GlassVerModule>GlassSetup</GlassVerModule>
  </PropertyGroup>
</Project>
