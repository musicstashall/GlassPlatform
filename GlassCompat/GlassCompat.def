    GlassCompat_EnsureTaskbarCompatLoaded
    GlassCompat_EnsureExplorerCompatLoaded
    GlassCompat_EnsureUICompatLoaded
    GlassCompat_WinEventProc
    GlassCompat_CwForceUnloadFlag DATA
    GlassCompat_GuiThreadId DATA
    Main
