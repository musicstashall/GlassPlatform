        AppListEntry="none"
        DisplayName="Glass Platform"
        Description="Glass desktop context menu"
        BackgroundColor="#202060"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Glass Shell Menu">
              <com:Class Id="6D4E18F4-91B2-4C7D-A3E9-442B7C889D41" Path="GlassShellExt.dll" ThreadingModel="STA" />
              <com:Class Id="8B219A33-0456-418E-B5D8-991C2E774E52" Path="GlassShellExt.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="Directory\Background">
              <desktop5:Verb Id="GlassPlatform00Toggle" Clsid="6D4E18F4-91B2-4C7D-A3E9-442B7C889D41" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
