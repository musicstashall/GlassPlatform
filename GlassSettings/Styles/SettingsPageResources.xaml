<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="SettingsCardSpacing">4</x:Double>
    <Style x:Key="SettingsSectionHeaderTextBlockStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="Margin" Value="1,30,0,6" />
    </Style>
    <Style x:Key="SettingsPageContentBorderStyle" TargetType="Border">
        <Setter Property="MaxWidth" Value="1064" />
    </Style>
</ResourceDictionary>
