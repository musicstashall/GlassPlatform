<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- WinUI cold-start на x86: default 1MB стека мало для PostNav+Ensure; 4MB для обеих arch. -->
    <StackReserveSize>4194304</StackReserveSize>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>GlassSettings</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;x86</Platforms>
    <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Unpackaged: кладёт WASDK в Build\…, иначе Bootstrap требует Appx WAR той же версии/arch (x86 2.1.3 часто нет → AV). -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- WASDK MUI: только en-US (десятки af-ZA/… раздувают output; UI-строки GS — в PRI). -->
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
    <!-- RID по Platform (не по архитектуре MSBuild-процесса): иначе x86-сборка на OS x64 уходит в win-x64. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$(Platform)</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultLanguage>ru-RU</DefaultLanguage>
    <SupportedLanguages>ru-RU;en-US</SupportedLanguages>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_BREAK_ON_UNHANDLED_EXCEPTION;DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Core\obj\**" />
    <Compile Remove="Core\bin\**" />
    <None Remove="Core\obj\**" />
    <None Remove="Core\bin\**" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\folder.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.1.240916" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.6" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.1.3" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.3.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
    <UiLanguageCatalogGeneratedFile>$(IntermediateOutputPath)UiLanguageCatalog.g.cs</UiLanguageCatalogGeneratedFile>
  </PropertyGroup>

  <!-- Список BCP-47 из Strings/*/Resources.resw → UiLanguageCatalog.EmbeddedLanguageTags -->
  <PropertyGroup>
    <CoreCompileDependsOn>GenerateUiLanguageCatalog;$(CoreCompileDependsOn)</CoreCompileDependsOn>
  </PropertyGroup>
  <!-- GlassSettings.Native.dll — рядом с exe; без этого остаётся устаревшая DLL после правок PartRegistryNative. -->
  <PropertyGroup>
    <GlassSettingsNativeProject>$(MSBuildProjectDirectory)\Native\GlassSettings.Native.vcxproj</GlassSettingsNativeProject>
    <!-- C# Platform=x86 → VC Platform=Win32 (как у остальных native-проектов solution). -->
    <GlassSettingsNativePlatform Condition="'$(Platform)' == 'x86'">Win32</GlassSettingsNativePlatform>
    <GlassSettingsNativePlatform Condition="'$(GlassSettingsNativePlatform)' == ''">$(Platform)</GlassSettingsNativePlatform>
  </PropertyGroup>
  <Target Name="BuildGlassSettingsNative" BeforeTargets="Build">
    <MSBuild Projects="$(GlassSettingsNativeProject)"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=$(GlassSettingsNativePlatform);SolutionDir=$(SolutionRoot)" />
  </Target>

  <!-- Self-contained WASDK копирует все *.mui-культуры — оставляем только en-US / en-us. -->
  <Target Name="TrimWasdkLanguageFolders" AfterTargets="CopyFilesToOutputDirectory">
    <PropertyGroup>
      <_OutDirFull>$([System.IO.Path]::GetFullPath('$(OutputPath)'))</_OutDirFull>
    </PropertyGroup>
    <Exec Condition="Exists('$(_OutDirFull)')"
          IgnoreExitCode="true"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$keep=@('en-US','en-us'); Get-ChildItem -LiteralPath '$(_OutDirFull.TrimEnd('\'))' -Directory -ErrorAction SilentlyContinue | Where-Object { $_.Name -match '^[a-z]{2,3}([_-][A-Za-z0-9]+)+$' -and $keep -notcontains $_.Name } | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue&quot;" />
  </Target>

  <!-- SDK StackReserveSize на apphost не всегда применяется; editbin после копирования exe. -->
  <Target Name="SetGlassSettingsStackReserve" AfterTargets="CopyFilesToOutputDirectory">
    <PropertyGroup>
      <_EditBinExe Condition="'$(_EditBinExe)' == '' and Exists('$(MSBuildProgramFiles32)\Microsoft Visual Studio\2022\Professional\VC\Tools\MSVC\14.44.35207\bin\HostX64\x64\editbin.exe')">$(MSBuildProgramFiles32)\Microsoft Visual Studio\2022\Professional\VC\Tools\MSVC\14.44.35207\bin\HostX64\x64\editbin.exe</_EditBinExe>
      <_EditBinExe Condition="'$(_EditBinExe)' == '' and Exists('C:\Program Files\Microsoft Visual Studio\2022\Professional\VC\Tools\MSVC\14.35.32215\bin\HostX64\x64\editbin.exe')">C:\Program Files\Microsoft Visual Studio\2022\Professional\VC\Tools\MSVC\14.35.32215\bin\HostX64\x64\editbin.exe</_EditBinExe>
    </PropertyGroup>
    <Exec Condition="'$(_EditBinExe)' != '' and Exists('$(TargetPath)')"
          Command="&quot;$(_EditBinExe)&quot; /STACK:4194304 &quot;$(TargetPath)&quot;"
          IgnoreExitCode="true" />
  </Target>

  <Target Name="GenerateUiLanguageCatalog"
          Inputs="$(MSBuildProjectDirectory)\Strings\*\Resources.resw"
          Outputs="$(UiLanguageCatalogGeneratedFile)">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          IgnoreExitCode="False"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$tags = @(Get-ChildItem -Path 'Strings' -Directory | Sort-Object Name | ForEach-Object { [char]34 + $_.Name + [char]34 }); if (-not $tags) { $tags = @([char]34 + 'en-US' + [char]34, [char]34 + 'ru-RU' + [char]34) }; $body = 'namespace GlassSettings.Strings;' + [Environment]::NewLine + 'public static partial class UiLanguageCatalog' + [Environment]::NewLine + '{' + [Environment]::NewLine + '    public static readonly IReadOnlyList&lt;string&gt; EmbeddedLanguageTags = new[] { ' + ($tags -join ', ') + ' };' + [Environment]::NewLine + '}'; [System.IO.File]::WriteAllText('$(UiLanguageCatalogGeneratedFile)', $body, [System.Text.UTF8Encoding]::new($false))&quot;" />
    <ItemGroup>
      <Compile Include="$(UiLanguageCatalogGeneratedFile)" />
      <FileWrites Include="$(UiLanguageCatalogGeneratedFile)" />
    </ItemGroup>
  </Target>
</Project>
