<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GlassSettings.TextWizard.TextVisualTuningWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">
            <TitleBar.LeftHeader>
                <HyperlinkButton
                    x:Name="TitleBarBackButton"
                    MinWidth="44"
                    MinHeight="32"
                    Margin="4,0,0,0"
                    Padding="12,0,8,0"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Click="TitleBarBackButton_OnClick">
                    <FontIcon Glyph="&#xE72B;" FontSize="12" />
                </HyperlinkButton>
            </TitleBar.LeftHeader>
        </TitleBar>

        <Grid Grid.Row="1" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,8,0,0" VerticalAlignment="Top">
                <Grid x:Name="BodyContentHost" VerticalAlignment="Top">
                    <Grid x:Name="PageTransitionClip" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                        <Grid x:Name="PageTransitionHost" VerticalAlignment="Top" HorizontalAlignment="Stretch" />
                    </Grid>
                </Grid>
            </Grid>

            <StackPanel Grid.Row="1" VerticalAlignment="Top" Spacing="0">
                <Border
                    x:Name="FooterDivider"
                    Height="1"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Grid
                    x:Name="FooterChromeHost"
                    VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid
                        x:Name="FooterButtonHost"
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="CancelButton"
                            Grid.Column="1"
                            MinWidth="96"
                            MinHeight="32"
                            VerticalAlignment="Center"
                            Click="CancelButton_OnClick" />
                        <Button
                            x:Name="NextButton"
                            Grid.Column="2"
                            MinWidth="96"
                            MinHeight="32"
                            VerticalAlignment="Center"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="NextButton_OnClick" />
                    </Grid>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
