<Page
    x:Class="GlassSettings.Pages.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:GlassSettings.Controls">
    <ScrollViewer
        x:Name="ContentScroll"
        Padding="36,24,36,24"
        HorizontalAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Border
            x:Name="ContentColumn"
            Margin="0,0,0,32"
            Style="{StaticResource SettingsPageContentBorderStyle}">
            <ctrl:PageHeader x:Name="Header" />
        </Border>
    </ScrollViewer>
</Page>