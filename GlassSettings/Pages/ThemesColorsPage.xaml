<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GlassSettings.Pages.ThemesColorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:GlassSettings.Controls">
    <ctrl:SettingsPageShell x:Name="PageShell">
        <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
            <ctrl:SettingsSystemGateExpander
                x:Name="ModeExpander"
                DimHeaderActionsWithGate="False"
                ShowGateSwitch="False">
                <ctrl:SettingsParameterPanel x:Name="ModeParameterPanel" />
            </ctrl:SettingsSystemGateExpander>

            <ctrl:SettingsFlatGateRow
                x:Name="TransparencyRow"
                GateToggled="TransparencyRow_OnGateToggled" />

            <ctrl:SettingsSystemGateExpander
                x:Name="AccentExpander"
                DimHeaderActionsWithGate="False"
                ShowGateSwitch="False"
                IsExpanded="True">
                <ctrl:SettingsColorPickerPanel
                    x:Name="AccentColorPanel"
                    DefaultColorClick="AccentColorPanel_OnDefaultColorClick">
                    <ctrl:GlassAlphaColorPicker
                        x:Name="AccentColorPicker"
                        IsAlphaVisible="False"
                        UseLivePreview="True"
                        ColorChanged="AccentColorPicker_OnColorChanged" />
                </ctrl:SettingsColorPickerPanel>
            </ctrl:SettingsSystemGateExpander>
        </StackPanel>
    </ctrl:SettingsPageShell>
</Page>
