<Page

    x:Class="GlassSettings.Pages.SystemPage"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:ctrl="using:GlassSettings.Controls">

    <ctrl:SettingsPageShell x:Name="PageShell">

        <StackPanel Spacing="{StaticResource SettingsCardSpacing}">

            <ctrl:SettingsInfoBlock x:Name="SystemInfoBlock" />

            <ctrl:SettingsNavigationHost x:Name="NavHost" />

            <ctrl:SettingsOptionRow x:Name="ShellExtensionRow">

                <ctrl:GlassSettingsLabeledToggleSwitch x:Name="ShellExtensionSwitch" Toggled="ShellExtensionSwitch_OnToggled" />

            </ctrl:SettingsOptionRow>

            <ctrl:SettingsInfoBlock x:Name="ShellMenuNoticeBlock" IconGlyph="&#xE7BA;" Visibility="Collapsed" />

            <ctrl:SettingsSystemGateExpander
                x:Name="MaintenanceExpander"
                ShowGateSwitch="False"
                DimHeaderActionsWithGate="False"
                HorizontalAlignment="Stretch">
                <ctrl:SettingsSystemGateExpander.HeaderActions>
                    <Button x:Name="MaintenanceModifyButton"
                            Click="MaintenanceModify_OnClick" />
                </ctrl:SettingsSystemGateExpander.HeaderActions>
            </ctrl:SettingsSystemGateExpander>

            <ctrl:SettingsSystemGateExpander x:Name="BackupExpander"
                    ShowGateSwitch="False" HorizontalAlignment="Stretch">
                <Grid HorizontalAlignment="Stretch" MinWidth="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="12" HorizontalAlignment="Stretch">
                        <TextBlock x:Name="BackupHeading" TextWrapping="Wrap" />
                        <TextBlock x:Name="BackupInstruction" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Row="1" x:Name="RegistryBackupButton"
                            Margin="0,16,0,0" HorizontalAlignment="Right"
                            Click="RegistryBackup_OnClick" />
                    <TextBlock x:Name="RegistryBackupStatus" Visibility="Collapsed" />
                </Grid>
            </ctrl:SettingsSystemGateExpander>

            <ctrl:SettingsOptionRow x:Name="UpdateIntervalRow">

                <ComboBox

                    x:Name="UpdateIntervalCombo"

                    MinWidth="180"

                    SelectionChanged="UpdateIntervalCombo_OnSelectionChanged" />

            </ctrl:SettingsOptionRow>

        </StackPanel>

    </ctrl:SettingsPageShell>

</Page>


