<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Зона fade (~28 px) — SettingsScrollEdgeFade.cs -->
    <x:Double x:Key="SettingsScrollEdgeFadeHeight">28</x:Double>
    <Thickness x:Key="SettingsPageShellScrollPadding">36,16,36,24</Thickness>
    <!-- Верхний margin колонки: в scroll extent, под зону fade при offset=0 (padding ScrollViewer viewport не сдвигает) -->
    <Thickness x:Key="SettingsPageShellContentMargin">0,32,0,32</Thickness>
</ResourceDictionary>
