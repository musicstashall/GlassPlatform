<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Прозрачный content area и боковой pane в режиме Left (рядом с контентом). -->
    <!-- Overlay-pane (LeftMinimal): WinUI Default → AcrylicInAppFillColorDefaultBrush; не переопределяем. -->
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
    <Thickness x:Key="NavigationViewContentGridBorderThickness">0,0,0,0</Thickness>
    <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
    <SolidColorBrush x:Key="NavigationViewCompactPaneBackground" Color="Transparent" />
</ResourceDictionary>
