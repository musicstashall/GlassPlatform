<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="GlassSettings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:GlassSettings.Controls"
    xmlns:nav="using:GlassSettings.Navigation">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="WindowBlurSourceHost" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border
                x:Name="AcrylicBackdropLayer"
                Grid.RowSpan="2"
                Visibility="Collapsed" />
            <TitleBar
                x:Name="AppTitleBar"
                Grid.Row="0"
                Title=""
                IsBackButtonVisible="False"
                IsPaneToggleButtonVisible="False"
                PaneToggleRequested="AppTitleBar_OnPaneToggleRequested">
                <TitleBar.LeftHeader>
                    <HyperlinkButton
                        x:Name="TitleBarBackButton"
                        MinWidth="44"
                        MinHeight="32"
                        Margin="4,0,0,0"
                        Padding="12,0,8,0"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Click="TitleBarBackButton_OnClick">
                        <FontIcon Glyph="&#xE72B;" FontSize="12" />
                    </HyperlinkButton>
                </TitleBar.LeftHeader>
                <TitleBar.Content>
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Width="360"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        PlaceholderText=""
                        QueryIcon="Find"
                        QuerySubmitted="SearchBox_OnQuerySubmitted" />
                </TitleBar.Content>
            </TitleBar>
            <NavigationView
                x:Name="NavView"
                Grid.Row="1"
                Background="Transparent"
                Visibility="Visible"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                IsSettingsVisible="False"
                IsTitleBarAutoPaddingEnabled="False"
                PaneDisplayMode="Left"
                OpenPaneLength="320"
                PaneClosed="NavView_OnPaneClosed">
                <NavigationView.PaneFooter>
                    <Button
                        x:Name="AppSettingsPaneButton"
                        MinWidth="44"
                        MinHeight="40"
                        Margin="4,0,0,4"
                        Padding="12,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="AppSettingsPaneButton_OnClick">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE713;" FontSize="16" />
                            <TextBlock x:Name="AppSettingsPaneLabel" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </NavigationView.PaneFooter>
                <NavigationView.PaneHeader>
                    <StackPanel x:Name="NavigationPaneHeaderStack">
                        <Grid x:Name="NavigationUserCardHost">
                            <ctrl:NavigationUserCard />
                        </Grid>
                        <Grid
                            x:Name="NavigationPaneSearchHost"
                            Margin="12,0,12,8"
                            Visibility="Collapsed" />
                    </StackPanel>
                </NavigationView.PaneHeader>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid
                        x:Name="PageContentHost"
                        Grid.Row="0"
                        Background="Transparent"
                        HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border
                            x:Name="TrailColumn"
                            Grid.Row="0"
                            Padding="{StaticResource SettingsBreadcrumbHostPadding}"
                            Style="{StaticResource SettingsPageContentBorderStyle}">
                            <BreadcrumbBar
                                x:Name="TrailBreadcrumb"
                                ItemClicked="TrailBreadcrumb_OnItemClicked">
                                <BreadcrumbBar.ItemTemplate>
                                    <DataTemplate x:DataType="nav:SettingsBreadcrumbItem">
                                        <TextBlock
                                            Style="{StaticResource GlassSettingsBreadcrumbTrailTextStyle}"
                                            Text="{x:Bind Name}" />
                                    </DataTemplate>
                                </BreadcrumbBar.ItemTemplate>
                            </BreadcrumbBar>
                        </Border>
                        <Grid Grid.Row="1">
                            <Frame
                                x:Name="NavFrame"
                                Background="Transparent"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
                            <Grid
                                x:Name="WindowTopNoticeShadowCastGrid"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
                            <Grid
                                x:Name="WindowTopNoticeColumn"
                                Margin="36,16,36,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                IsHitTestVisible="True"
                                RenderTransformOrigin="0.5,0"
                                Translation="0,0,12"
                                Visibility="Collapsed">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="WindowTopNoticeTransform" />
                                </Grid.RenderTransform>
                                <Grid.Shadow>
                                    <ThemeShadow x:Name="WindowTopNoticeShadow" />
                                </Grid.Shadow>
                                <StackPanel
                                    x:Name="WindowTopNoticeMirrorStack"
                                    HorizontalAlignment="Stretch"
                                    Spacing="8" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </NavigationView>
        </Grid>
        <Grid
            x:Name="WindowBusyOverlay"
            Grid.RowSpan="2"
            Background="Transparent"
            IsHitTestVisible="True"
            Visibility="Collapsed">
            <Rectangle x:Name="WindowBusyOverlayFill" />
            <ProgressRing
                x:Name="WindowBusyProgressRing"
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="True" />
        </Grid>
        <Grid
            x:Name="HostedDialogHost"
            Grid.RowSpan="2"
            Background="Transparent"
            Visibility="Collapsed">
            <Grid
                x:Name="DialogShadowCastGrid"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />
            <Grid
                x:Name="DialogBoundsHost"
                Margin="20"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
                <Border
                    x:Name="DialogShadowRect"
                    MinWidth="480"
                    MaxWidth="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Translation="0,0,64">
                    <Border.Shadow>
                        <ThemeShadow x:Name="DialogShadow" />
                    </Border.Shadow>
                    <Border
                        x:Name="HostedDialogSurface"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Padding="{ThemeResource ContentDialogPadding}">
                        <ContentControl
                            x:Name="HostedDialogContent"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
                    </Border>
                </Border>
            </Grid>
        </Grid>
        <Grid
            x:Name="LoadingOverlay"
            Grid.RowSpan="2"
            Background="Transparent"
            IsHitTestVisible="True"
            Visibility="Visible"
            PointerPressed="LoadingOverlay_OnPointerInput"
            PointerReleased="LoadingOverlay_OnPointerInput"
            PointerCanceled="LoadingOverlay_OnPointerInput"
            PointerCaptureLost="LoadingOverlay_OnPointerInput"
            Tapped="LoadingOverlay_OnTappedInput"
            DoubleTapped="LoadingOverlay_OnDoubleTappedInput">
            <Image
                x:Name="LoadingIcon"
                Width="108"
                Height="108"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Source="ms-appx:///Assets/app.ico"
                Stretch="Uniform" />
        </Grid>
    </Grid>
</Window>
