<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GlassSettings.Controls.WizardInkPreviewCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Center"
    VerticalAlignment="Top">
    <Grid Margin="{StaticResource GlassSettingsHeroPreviewShadowMargin}">
        <Border
            x:Name="CardChrome"
            Width="{StaticResource GlassSettingsTextLayerPreviewOuterWidth}"
            Height="{StaticResource GlassSettingsTextLayerPreviewOuterHeight}"
            Padding="16"
            Background="Transparent"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="{StaticResource GlassSettingsTextLayerPreviewBorderThickness}"
            CornerRadius="6">
            <Border.Shadow>
                <ThemeShadow x:Name="CardShadow" />
            </Border.Shadow>
            <Image
                x:Name="PreviewImage"
                IsHitTestVisible="False"
                Stretch="Fill"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />
        </Border>
    </Grid>
</UserControl>
