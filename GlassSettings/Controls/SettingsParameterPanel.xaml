<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="GlassSettings.Controls.SettingsParameterPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Stretch">

    <Grid
        x:Name="LayoutRoot"
        Margin="-12,-4,-12,-10"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="DescriptionHeader"
            Grid.Row="0"
            Padding="28,22,16,0"
            HorizontalAlignment="Stretch">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Ellipse
                x:Name="DescriptionBullet"
                Width="5"
                Height="5"
                Margin="0,7,10,0"
                VerticalAlignment="Top"
                Fill="{ThemeResource TextFillColorTertiaryBrush}" />

            <TextBlock
                x:Name="DescriptionText"
                Grid.Column="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                LineHeight="18"
                Style="{StaticResource GlassSettingsSpoilerSecondaryTextStyle}"
                TextWrapping="WrapWholeWords" />
        </Grid>

        <Border
            x:Name="TopDivider"
            Grid.Row="1"
            Margin="28,14,16,0"
            HorizontalAlignment="Stretch"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Visibility="Collapsed" />

        <ContentPresenter
            x:Name="BodyHost"
            Grid.Row="2"
            Margin="28,12,16,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top" />

        <StackPanel
            x:Name="DefaultActionPanel"
            Grid.Row="3"
            Margin="28,0,16,14"
            HorizontalAlignment="Stretch"
            Visibility="Collapsed">
            <Border
                x:Name="DefaultActionDivider"
                Margin="0,10,0,10"
                HorizontalAlignment="Stretch"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0" />
            <Button
                x:Name="DefaultButton"
                Padding="12,6"
                HorizontalAlignment="Left"
                Click="DefaultButton_OnClick"
                Style="{StaticResource DefaultButtonStyle}" />
        </StackPanel>

        <Border
            x:Name="FocusSink"
            Grid.Row="3"
            Width="0"
            Height="0"
            Opacity="0"
            IsTabStop="True"
            IsHitTestVisible="False" />

    </Grid>

</UserControl>
