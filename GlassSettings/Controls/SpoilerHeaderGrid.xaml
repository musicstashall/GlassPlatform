<?xml version="1.0" encoding="utf-8"?>

<UserControl

    x:Class="GlassSettings.Controls.SpoilerHeaderGrid"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:ctrl="using:GlassSettings.Controls"

    HorizontalAlignment="Stretch"

    HorizontalContentAlignment="Stretch"

    VerticalAlignment="Center">

    <Grid x:Name="HeaderGrid" Padding="0,2" HorizontalAlignment="Stretch">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="Auto" />

            <ColumnDefinition MinWidth="{StaticResource GlassSettingsSectionTitleMinWidth}" Width="*" />

            <ColumnDefinition Width="Auto" />

            <ColumnDefinition Width="Auto" />

        </Grid.ColumnDefinitions>

        <StackPanel
            Grid.Column="0"
            Margin="6,0,12,0"
            Orientation="Horizontal"
            Spacing="8"
            VerticalAlignment="Center">
            <ctrl:UnsavedIndicatorDot x:Name="UpdateDot" />
            <ctrl:UnsavedIndicatorDot x:Name="UnsavedDot" />
            <FontIcon
                x:Name="SectionIcon"
                FontSize="{StaticResource GlassSettingsSectionIconSize}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                VerticalAlignment="Center"
                Visibility="Collapsed" />
        </StackPanel>

        <StackPanel

            x:Name="TitlePanel"

            Grid.Column="1"

            Margin="0,0,10,0"

            MinWidth="{StaticResource GlassSettingsSectionTitleMinWidth}"

            VerticalAlignment="Center"

            Spacing="2">

            <TextBlock
                x:Name="TitleText"
                Style="{StaticResource GlassSettingsSpoilerTitleTextStyle}"
                TextTrimming="CharacterEllipsis" />

            <TextBlock
                x:Name="DescriptionText"
                Style="{StaticResource GlassSettingsSpoilerSecondaryTextStyle}"
                TextWrapping="WrapWholeWords" />
            <TextBlock
                x:Name="ParallelDuplicateText"
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                Style="{StaticResource GlassSettingsSpoilerSecondaryTextStyle}"
                Text=""
                TextWrapping="WrapWholeWords"
                Visibility="Collapsed" />

            <HyperlinkButton

                x:Name="UpdateLineLink"

                Padding="0"

                HorizontalAlignment="Stretch"

                HorizontalContentAlignment="Left"

                FontSize="12"

                Visibility="Collapsed" />

        </StackPanel>

        <ContentPresenter

            x:Name="ControlsTableHost"

            Grid.Column="2"

            HorizontalAlignment="Right"

            HorizontalContentAlignment="Right"

            VerticalAlignment="Center" />

        <StackPanel

            x:Name="TrailingRailPanel"

            Grid.Column="3"

            Margin="{StaticResource GlassSettingsTrailingRailMargin}"

            Orientation="Horizontal"

            Spacing="{StaticResource GlassSettingsToggleChevronSpacing}"

            VerticalAlignment="Center">

            <ContentPresenter

                x:Name="StaticHost"

                HorizontalAlignment="Right"

                HorizontalContentAlignment="Right"

                VerticalAlignment="Center" />

            <FontIcon

                x:Name="ChevronIcon"

                Glyph="&#xE76C;"

                FontSize="16"

                Foreground="{ThemeResource TextFillColorSecondaryBrush}"

                IsHitTestVisible="False"

                VerticalAlignment="Center" />

        </StackPanel>

    </Grid>

</UserControl>
