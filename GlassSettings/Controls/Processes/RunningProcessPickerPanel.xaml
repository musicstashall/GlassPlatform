<UserControl
    x:Class="GlassSettings.Controls.Processes.RunningProcessPickerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Stretch">
    <UserControl.Resources>
        <Style x:Key="ProcessPickerSearchBoxHostStyle" TargetType="Border">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,*">
        <Border
            Grid.Row="0"
            Margin="0,0,0,12"
            Style="{StaticResource ProcessPickerSearchBoxHostStyle}">
            <Grid VerticalAlignment="Stretch">
                <TextBox
                    x:Name="SearchBox"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8,6,28,6"
                    PlaceholderText="{x:Bind SearchPlaceholderText, Mode=OneTime}"
                    TextChanged="SearchBox_OnTextChanged" />
                <FontIcon
                    x:Name="SearchGlyph"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE721;" />
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <ListView
                x:Name="ProcessListView"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ItemTemplate="{StaticResource RunningProcessPickerItemTemplate}"
                SelectionChanged="ProcessListView_OnSelectionChanged"
                SelectionMode="Single" />
            <TextBlock
                x:Name="EmptyText"
                HorizontalAlignment="Center"
                Margin="0,24,0,24"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind EmptyListText, Mode=OneTime}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</UserControl>
