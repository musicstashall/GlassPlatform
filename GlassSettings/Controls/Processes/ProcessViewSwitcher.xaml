<UserControl
    x:Class="GlassSettings.Controls.Processes.ProcessViewSwitcher"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SelectorBar
        x:Name="Bar"
        Padding="0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Center"
        SelectionChanged="Bar_OnSelectionChanged">
        <SelectorBarItem x:Name="ListItem" IsSelected="True">
            <SelectorBarItem.Icon>
                <FontIcon FontSize="18" Glyph="&#xE8FD;" />
            </SelectorBarItem.Icon>
        </SelectorBarItem>
        <SelectorBarItem x:Name="TilesItem">
            <SelectorBarItem.Icon>
                <FontIcon FontSize="18" Glyph="&#xE8A9;" />
            </SelectorBarItem.Icon>
        </SelectorBarItem>
        <SelectorBarItem x:Name="CompactItem">
            <SelectorBarItem.Icon>
                <FontIcon FontSize="18" Glyph="&#xE8A1;" />
            </SelectorBarItem.Icon>
        </SelectorBarItem>
    </SelectorBar>
</UserControl>
