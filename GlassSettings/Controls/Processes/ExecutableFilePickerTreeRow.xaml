<UserControl
    x:Class="GlassSettings.Controls.Processes.ExecutableFilePickerTreeRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinHeight="32"
    HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    VerticalAlignment="Stretch"
    VerticalContentAlignment="Center">
    <Grid
        x:Name="RootPanel"
        MinHeight="32"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Center"
        ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" MinWidth="0" />
        </Grid.ColumnDefinitions>
        <Grid
            Grid.Column="0"
            Width="20"
            Height="20"
            VerticalAlignment="Center">
            <FontIcon
                x:Name="GroupIcon"
                Width="20"
                Height="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE81E;"
                Visibility="Collapsed" />
            <SymbolIcon
                x:Name="DriveIcon"
                Width="20"
                Height="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Symbol="XboxOneConsole"
                Visibility="Collapsed" />
            <FontIcon
                x:Name="FolderFallbackIcon"
                Width="20"
                Height="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE8B7;"
                Visibility="Collapsed" />
            <Image
                x:Name="FolderIcon"
                Width="20"
                Height="20"
                Stretch="Uniform"
                Visibility="Collapsed" />
        </Grid>
        <TextBlock
            x:Name="NameText"
            Grid.Column="1"
            FontSize="12"
            MaxLines="1"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap"
            VerticalAlignment="Center" />
    </Grid>
</UserControl>
