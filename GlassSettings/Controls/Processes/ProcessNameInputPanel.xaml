<UserControl
    x:Class="GlassSettings.Controls.Processes.ProcessNameInputPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    Loaded="ProcessNameInputPanel_OnLoaded">
    <Grid MinHeight="32" VerticalAlignment="Center">
        <TextBox
            x:Name="InputBox"
            MinHeight="32"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            PlaceholderText="{x:Bind PlaceholderText, Mode=OneTime}"
            PreviewKeyDown="InputBox_OnPreviewKeyDown" />
    </Grid>
</UserControl>
