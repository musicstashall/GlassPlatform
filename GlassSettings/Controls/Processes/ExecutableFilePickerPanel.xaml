<UserControl
    x:Class="GlassSettings.Controls.Processes.ExecutableFilePickerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GlassSettings.Controls.Processes"
    xmlns:services="using:GlassSettings.Services"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    MinWidth="320"
    HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    VerticalAlignment="Stretch"
    SizeChanged="Root_OnSizeChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="FilePickerBreadcrumbBar.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <x:Double x:Key="BreadcrumbBarItemThemeFontSize">14</x:Double>
        <x:Double x:Key="BreadcrumbBarChevronFontSize">10</x:Double>
        <Thickness x:Key="BreadcrumbBarChevronPadding">4,0,4,0</Thickness>
        <Style x:Key="FilePickerNavigationBarGridStyle" TargetType="Grid">
            <Setter Property="Height" Value="56" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style x:Key="FilePickerCommandBarGridStyle" TargetType="Grid">
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style x:Key="FilePickerAddressBarGridStyle" TargetType="Border">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="FilePickerSearchBoxHostStyle" TargetType="Border">
            <Setter Property="Width" Value="200" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <DataTemplate x:Key="FilePickerTreeGroupTemplate" x:DataType="services:ExecutableFilePickerTreeItem">
            <TreeViewItem
                AutomationProperties.Name="{x:Bind Name}"
                HasUnrealizedChildren="{x:Bind HasUnloadedChildren}"
                IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                ItemsSource="{x:Bind Children}">
                <local:ExecutableFilePickerTreeRow />
            </TreeViewItem>
        </DataTemplate>
        <DataTemplate x:Key="FilePickerTreeDriveTemplate" x:DataType="services:ExecutableFilePickerTreeItem">
            <TreeViewItem
                AutomationProperties.Name="{x:Bind Name}"
                HasUnrealizedChildren="{x:Bind HasUnloadedChildren}"
                IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                ItemsSource="{x:Bind Children}">
                <local:ExecutableFilePickerTreeRow />
            </TreeViewItem>
        </DataTemplate>
        <DataTemplate x:Key="FilePickerTreeFolderTemplate" x:DataType="services:ExecutableFilePickerTreeItem">
            <TreeViewItem
                AutomationProperties.Name="{x:Bind Name}"
                HasUnrealizedChildren="{x:Bind HasUnloadedChildren}"
                IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                ItemsSource="{x:Bind Children}">
                <local:ExecutableFilePickerTreeRow />
            </TreeViewItem>
        </DataTemplate>
        <local:ExecutableFilePickerTreeTemplateSelector
            x:Key="FilePickerTreeTemplateSelector"
            DriveTemplate="{StaticResource FilePickerTreeDriveTemplate}"
            FolderTemplate="{StaticResource FilePickerTreeFolderTemplate}"
            GroupTemplate="{StaticResource FilePickerTreeGroupTemplate}" />
        <DataTemplate x:Key="FilePickerBreadcrumbTemplate" x:DataType="services:ExecutableFilePickerBreadcrumbItem">
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind Name}"
                TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <ItemsPanelTemplate x:Key="FilePickerListItemsPanel">
            <ItemsStackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="FilePickerLargeIconsItemsPanel">
            <ItemsWrapGrid
                Orientation="Horizontal"
                MaximumRowsOrColumns="32"
                ItemWidth="120"
                ItemHeight="148" />
        </ItemsPanelTemplate>
        <!-- Без indent ListViewItem (иначе карточка уезжает вправо/вверх и обрезается). -->
        <Style x:Key="FilePickerLargeIconItemContainerStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid
            x:Name="NavigationBarControlGrid"
            Grid.Row="0"
            Style="{StaticResource FilePickerNavigationBarGridStyle}">
            <Grid
                x:Name="NavigationBarInnerGrid"
                Height="32"
                Margin="24,0,24,0"
                VerticalAlignment="Center"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <Button
                        x:Name="BackButton"
                        MinWidth="20"
                        MinHeight="20"
                        Padding="2"
                        Click="BackButton_OnClick"
                        IsEnabled="False"
                        Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon FontSize="12" Glyph="&#xE72B;" />
                    </Button>
                    <Button
                        x:Name="ForwardButton"
                        MinWidth="20"
                        MinHeight="20"
                        Margin="24,0,0,0"
                        Padding="2"
                        Click="ForwardButton_OnClick"
                        IsEnabled="False"
                        Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon FontSize="12" Glyph="&#xE72A;" />
                    </Button>
                    <Button
                        x:Name="RefreshButton"
                        MinWidth="20"
                        MinHeight="20"
                        Margin="24,0,0,0"
                        Padding="2"
                        Click="RefreshButton_OnClick"
                        Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon FontSize="12" Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>
                <Border
                    x:Name="FileExplorerAddressBarGrid"
                    Grid.Column="1"
                    PointerPressed="FilePickerBarHost_OnPointerPressed"
                    Tapped="FileExplorerAddressBarGrid_OnTapped"
                    Style="{StaticResource FilePickerAddressBarGridStyle}">
                    <Grid Height="32" VerticalAlignment="Center" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="HomeButton"
                            MinWidth="20"
                            MinHeight="20"
                            Padding="2"
                            VerticalAlignment="Center"
                            Click="HomeButton_OnClick"
                            Style="{StaticResource SubtleButtonStyle}">
                            <FontIcon FontSize="12" Glyph="&#xE80F;" />
                        </Button>
                        <Grid
                            x:Name="AddressBarContentHost"
                            Grid.Column="1"
                            AllowFocusOnInteraction="True"
                            IsTabStop="True"
                            Tapped="AddressBarContentHost_OnTapped">
                            <BreadcrumbBar
                                x:Name="PathBreadcrumb"
                                Margin="0,-3,0,0"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                ItemClicked="PathBreadcrumb_OnItemClicked"
                                ItemTemplate="{StaticResource FilePickerBreadcrumbTemplate}">
                                <BreadcrumbBar.Resources>
                                    <Style BasedOn="{StaticResource FilePickerBreadcrumbBarItemStyle}" TargetType="controls:BreadcrumbBarItem" />
                                </BreadcrumbBar.Resources>
                            </BreadcrumbBar>
                            <TextBox
                                x:Name="AddressPathBox"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="8,6"
                                PlaceholderText="{x:Bind AddressPathPlaceholderText}"
                                TextWrapping="NoWrap"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                Visibility="Collapsed"
                                KeyDown="AddressPathBox_OnKeyDown"
                                LostFocus="AddressPathBox_OnLostFocus" />
                        </Grid>
                    </Grid>
                </Border>
                <Border
                    x:Name="FileExplorerSearchBox"
                    Grid.Column="2"
                    PointerPressed="FilePickerBarHost_OnPointerPressed"
                    Style="{StaticResource FilePickerSearchBoxHostStyle}">
                    <Grid VerticalAlignment="Stretch">
                        <TextBox
                            x:Name="SearchBox"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8,6,28,6"
                            PlaceholderText="{x:Bind SearchPlaceholderText}"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            TextChanged="SearchBox_OnTextChanged" />
                        <FontIcon
                            x:Name="SearchGlyph"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE721;"
                            IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Grid
            x:Name="CommandBarControlGrid"
            Grid.Row="1"
            Style="{StaticResource FilePickerCommandBarGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="TreePaneToggleButton"
                Grid.Column="0"
                MinWidth="20"
                MinHeight="20"
                Margin="24,0,0,0"
                Padding="2"
                VerticalAlignment="Center"
                Click="TreePaneToggleButton_OnClick"
                Style="{StaticResource SubtleButtonStyle}"
                Visibility="Collapsed">
                <FontIcon FontSize="12" Glyph="&#xE700;" />
            </Button>
            <StackPanel
                x:Name="SearchCommandBarPanel"
                Grid.Column="1"
                Margin="24,0,0,0"
                HorizontalAlignment="Left"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <Button
                    x:Name="SearchParametersButton"
                    MinHeight="28"
                    Padding="8,4"
                    Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE71C;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind SearchParametersButtonText}" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="CloseSearchButton"
                    MinHeight="28"
                    Padding="8,4"
                    Click="CloseSearchButton_OnClick"
                    Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind CloseSearchButtonText}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel
                Grid.Column="2"
                Margin="0,0,24,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <Button
                    x:Name="SortButton"
                    MinHeight="28"
                    Padding="8,4"
                    Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE8CB;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind SortButtonText}" />
                        <FontIcon FontSize="8" Glyph="&#xE70D;" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="ViewButton"
                    MinHeight="28"
                    Padding="8,4"
                    Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE890;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewButtonText}" />
                        <FontIcon FontSize="8" Glyph="&#xE70D;" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <Grid
            Grid.Row="2"
            VerticalAlignment="Stretch">
            <Grid x:Name="ContentHostGrid" VerticalAlignment="Stretch" SizeChanged="ContentHostGrid_OnSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TreeColumn" Width="260" MinWidth="0" />
                    <ColumnDefinition x:Name="TreeListGutterColumn" Width="12" />
                    <ColumnDefinition x:Name="TreeListDividerColumn" Width="1" />
                    <ColumnDefinition x:Name="ListColumn" Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>
                <TreeView
                    x:Name="FolderTreeView"
                    Padding="0"
                    Expanding="FolderTreeView_OnExpanding"
                    Collapsed="FolderTreeView_OnCollapsed"
                    ItemTemplateSelector="{StaticResource FilePickerTreeTemplateSelector}"
                    ItemsSource="{x:Bind TreeRoots, Mode=OneWay}"
                    SelectionChanged="FolderTreeView_OnSelectionChanged"
                    VerticalAlignment="Stretch">
                    <TreeView.Resources>
                        <x:Double x:Key="TreeViewItemMinHeight">32</x:Double>
                        <Thickness x:Key="TreeViewItemPresenterPadding">0</Thickness>
                        <Thickness x:Key="TreeViewItemPresenterMargin">0</Thickness>
                    </TreeView.Resources>
                </TreeView>
                <Border
                    x:Name="TreeListDivider"
                    Grid.Column="2"
                    Width="1"
                    Margin="0,12,0,12"
                    VerticalAlignment="Stretch"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Grid Grid.Column="3" Margin="12,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid
                        x:Name="DetailsHeaderRow"
                        Margin="4,0,4,4"
                        ColumnSpacing="12"
                        Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="DetailsHeaderNameButton"
                            Grid.Column="1"
                            Padding="0,4"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="DetailsHeaderName_OnClick"
                            Style="{StaticResource SubtleButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind DetailsColumnNameText}" />
                                <FontIcon
                                    x:Name="DetailsHeaderNameSortIcon"
                                    FontSize="8"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="DetailsHeaderTypeButton"
                            Grid.Column="2"
                            Padding="0,4"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="DetailsHeaderType_OnClick"
                            Style="{StaticResource SubtleButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind DetailsColumnTypeText}" />
                                <FontIcon
                                    x:Name="DetailsHeaderTypeSortIcon"
                                    FontSize="8"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ListView
                        x:Name="FileListView"
                        Grid.Row="1"
                        ItemTemplate="{StaticResource ExecutableFilePickerItemTemplate}"
                        ItemsPanel="{StaticResource FilePickerListItemsPanel}"
                        DoubleTapped="FileListView_OnDoubleTapped"
                        SelectionChanged="FileListView_OnSelectionChanged"
                        SelectionMode="Single"
                        VerticalAlignment="Stretch" />
                    <TextBlock
                        x:Name="EmptyText"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        Margin="0,24,0,24"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind EmptyListText}"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="SearchEmptyText"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        Margin="0,24,0,24"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind SearchNoResultsText}"
                        TextAlignment="Center"
                        VerticalAlignment="Top"
                        Visibility="Collapsed" />
                    <Grid
                        x:Name="SearchProgressPanel"
                        Grid.Row="1"
                        Visibility="Collapsed">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                            <ProgressRing
                                x:Name="SearchProgressRing"
                                Width="32"
                                Height="32"
                                IsActive="True" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind SearchInProgressText}"
                                TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
            <Grid
                x:Name="TreePaneOverlay"
                Visibility="Collapsed">
                <Border
                    Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                    Opacity="0.4"
                    PointerPressed="TreePaneDismissLayer_OnPointerPressed" />
                <Border
                    x:Name="TreePanePanel"
                    Width="280"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                    <TreeView
                        x:Name="FolderTreePaneView"
                        Padding="8,8,8,0"
                        Expanding="FolderTreeView_OnExpanding"
                    Collapsed="FolderTreeView_OnCollapsed"
                        ItemTemplateSelector="{StaticResource FilePickerTreeTemplateSelector}"
                        ItemsSource="{x:Bind TreeRoots, Mode=OneWay}"
                        SelectionChanged="FolderTreeView_OnSelectionChanged"
                        VerticalAlignment="Stretch">
                        <TreeView.Resources>
                            <x:Double x:Key="TreeViewItemMinHeight">32</x:Double>
                            <Thickness x:Key="TreeViewItemPresenterPadding">0</Thickness>
                            <Thickness x:Key="TreeViewItemPresenterMargin">0</Thickness>
                        </TreeView.Resources>
                    </TreeView>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
