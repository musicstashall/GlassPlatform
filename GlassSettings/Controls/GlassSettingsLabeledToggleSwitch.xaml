<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GlassSettings.Controls.GlassSettingsLabeledToggleSwitch"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Right"
    HorizontalContentAlignment="Right"
    VerticalAlignment="Center">
    <StackPanel
        Orientation="Horizontal"
        Spacing="6"
        HorizontalAlignment="Right"
        VerticalAlignment="Center">
        <TextBlock
            x:Name="StateText"
            MinWidth="40"
            TextAlignment="Right"
            VerticalAlignment="Center"
            Style="{StaticResource GlassSettingsSpoilerSecondaryTextStyle}"
            Text="" />
        <ToggleSwitch
            x:Name="InnerSwitch"
            Width="44"
            MinWidth="44"
            MaxWidth="44"
            Header=""
            OnContent=""
            OffContent=""
            Style="{StaticResource GlassSettingsCompactToggleSwitchStyle}"
            Toggled="InnerSwitch_OnToggled" />
    </StackPanel>
</UserControl>
