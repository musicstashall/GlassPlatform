<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GlassSettings.Controls.SettingsNavigateRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:GlassSettings.Controls"
    HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Stretch">
    <!-- См. GlassSettings/docs/GlassSettings-detail-cards.md — тип 2 (навигационная строка) -->
    <Border
        x:Name="RootBorder"
        MinHeight="{StaticResource GlassSettingsSystemExpanderHeaderMinHeight}"
        Padding="{StaticResource GlassSettingsOpacityRowPadding}"
        HorizontalAlignment="Stretch"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="RootBorder.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled" />
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel Spacing="8">
            <ctrl:SpoilerHeaderGrid x:Name="HeaderChrome" ShowChevron="True" />
            <ContentControl
                x:Name="ActionsBelowHost"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Right"
                Visibility="Collapsed" />
        </StackPanel>
    </Border>
</UserControl>
