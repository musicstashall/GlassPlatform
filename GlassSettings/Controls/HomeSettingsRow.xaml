<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GlassSettings.Controls.HomeSettingsRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Stretch">
    <StackPanel Spacing="0">
        <Border
            x:Name="RowBorder"
            MinHeight="{StaticResource HomeRowMinHeight}"
            Padding="12,10"
            HorizontalAlignment="Stretch"
            Background="Transparent"
            CornerRadius="8">
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    Margin="{StaticResource GlassSettingsSectionIconMargin}"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
                    <Ellipse
                        x:Name="StatusIndicatorDot"
                        Width="6"
                        Height="6"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                    <Ellipse
                        x:Name="UnsavedDot"
                        Width="6"
                        Height="6"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                    <FontIcon
                        x:Name="IconGlyph"
                        FontSize="{StaticResource GlassSettingsSectionIconSize}"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        x:Name="TitleText"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock
                            x:Name="SubtitlePrefix"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="SubtitleAccent"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="SubtitlePlain"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="{StaticResource GlassSettingsToggleChevronSpacing}"
                    VerticalAlignment="Center">
                    <ContentPresenter
                        x:Name="TrailingHost"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
                    <FontIcon
                        x:Name="ChevronIcon"
                        Glyph="&#xE76C;"
                        FontSize="16"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
        <Border
            x:Name="DividerHost"
            Height="1"
            Margin="12,0"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
    </StackPanel>
</UserControl>
