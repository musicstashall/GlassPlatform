<?xml version="1.0" encoding="utf-8"?>

<UserControl

    x:Class="GlassSettings.Controls.SettingsColorPickerPanel"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    HorizontalAlignment="Stretch"

    HorizontalContentAlignment="Stretch"

    SizeChanged="Root_OnSizeChanged">

    <Grid

        x:Name="LayoutRoot"

        Margin="-12,-4,-12,-10"

        HorizontalAlignment="Stretch"

        VerticalAlignment="Stretch"

        MinHeight="120">

        <Grid.ColumnDefinitions>

            <ColumnDefinition x:Name="InfoColumnDefinition" Width="*" MinWidth="{StaticResource GlassSettingsSectionTitleMinWidth}" />

            <ColumnDefinition x:Name="SeparatorColumnDefinition" Width="Auto" />

            <ColumnDefinition x:Name="PickerColumnDefinition" Width="Auto" />

        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>

            <RowDefinition Height="*" />

            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>

        <Grid

            x:Name="InfoColumn"

            Grid.Row="0"

            Grid.Column="0"

            Padding="28,22,16,14"

            HorizontalAlignment="Stretch"

            VerticalAlignment="Stretch">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto" />

                <RowDefinition Height="Auto" />

                <RowDefinition Height="*" MinHeight="24" />

            </Grid.RowDefinitions>

            <Grid Grid.Row="0" HorizontalAlignment="Stretch">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto" />

                    <ColumnDefinition Width="*" />

                </Grid.ColumnDefinitions>

                <Ellipse

                    x:Name="DescriptionBullet"

                    Width="5"

                    Height="5"

                    Margin="0,7,10,0"

                    VerticalAlignment="Top"

                    Fill="{ThemeResource TextFillColorTertiaryBrush}" />

                <TextBlock

                    x:Name="DescriptionText"

                    Grid.Column="1"

                    HorizontalAlignment="Left"

                    VerticalAlignment="Top"

                    LineHeight="18"

                    Style="{StaticResource GlassSettingsSpoilerSecondaryTextStyle}"

                    TextWrapping="WrapWholeWords" />

            </Grid>

            <Border

                x:Name="DescriptionDivider"

                Grid.Row="1"

                Margin="0,14,0,0"

                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"

                BorderThickness="0,1,0,0"

                Visibility="Collapsed" />

            <!-- Footer растягивается; Default — под ним (тумблеры prevalence прижимаются к низу footer). -->
            <Grid
                Grid.Row="2"
                Margin="0,12,0,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="0" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ContentPresenter
                    x:Name="FooterHost"
                    Grid.Row="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Visibility="Collapsed" />
                <StackPanel
                    x:Name="DefaultActionPanel"
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Visibility="Collapsed">
                    <Border
                        x:Name="DefaultActionDivider"
                        Margin="0,10,0,10"
                        HorizontalAlignment="Stretch"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0" />
                    <Button
                        x:Name="DefaultColorButton"
                        Padding="12,6"
                        HorizontalAlignment="Left"
                        Click="DefaultColorButton_OnClick"
                        Style="{StaticResource DefaultButtonStyle}" />
                </StackPanel>
            </Grid>

        </Grid>

        <Border

            x:Name="PickerSeparator"

            Grid.Row="0"

            Grid.Column="1"

            Width="1"

            Margin="0"

            VerticalAlignment="Stretch"

            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <Border

            x:Name="PickerZone"

            Grid.Row="0"

            Grid.Column="2"

            MinWidth="{StaticResource GlassSettingsPickerZoneMinWidth}"

            Padding="{StaticResource GlassSettingsColorPickerZonePadding}"

            HorizontalAlignment="Right"

            VerticalAlignment="Stretch"

            Background="{ThemeResource SubtleFillColorSecondaryBrush}"

            BorderThickness="0"

            CornerRadius="0">

            <ContentPresenter

                x:Name="PickerHost"

                HorizontalAlignment="Right"

                HorizontalContentAlignment="Right"

                VerticalAlignment="Top" />

        </Border>

    </Grid>

</UserControl>

