<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GlassSettings.Controls.Themes.SlideshowAlbumPickerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GlassSettings.Controls.Themes"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Stretch">
    <UserControl.Resources>
        <DataTemplate x:Key="AlbumImageTileTemplate" x:DataType="local:SlideshowAlbumImageItem">
            <Border
                Width="168"
                Padding="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Tag="{x:Bind}"
                PointerPressed="TileBorder_OnPointerPressed">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                    <Grid
                        Grid.Row="0"
                        Width="152"
                        Height="100"
                        HorizontalAlignment="Center">
                        <Border
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            CornerRadius="4"
                            IsHitTestVisible="False">
                            <Grid>
                                <ProgressRing
                                    Width="48"
                                    Height="48"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsActive="True"
                                    IsHitTestVisible="False"
                                    Visibility="{x:Bind LoadingRingVisibility, Mode=OneWay}" />
                                <Image
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Stretch="Uniform"
                                    Source="{x:Bind Thumbnail, Mode=OneWay}"
                                    Visibility="{x:Bind ThumbnailVisibility, Mode=OneWay}" />
                            </Grid>
                        </Border>
                        <CheckBox
                            MinWidth="0"
                            Margin="4,2,0,0"
                            Padding="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False"
                            IsChecked="{x:Bind IsIncluded, Mode=OneWay}" />
                    </Grid>
                    <TextBlock
                        Grid.Row="1"
                        MaxWidth="152"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        IsHitTestVisible="False"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind FileName}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        ToolTipService.ToolTip="{x:Bind FileName}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,*">
        <Grid
            x:Name="SelectionBar"
            Grid.Row="0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="AlbumFolderCombo"
                Grid.Column="0"
                MinWidth="200"
                MaxWidth="280"
                VerticalAlignment="Center"
                SelectionChanged="AlbumFolderCombo_OnSelectionChanged" />
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8">
                <Button
                    x:Name="SelectAllButton"
                    MinWidth="0"
                    Padding="10,6"
                    Click="SelectAllButton_OnClick"
                    Style="{StaticResource DefaultButtonStyle}" />
                <Button
                    x:Name="DeselectAllButton"
                    MinWidth="0"
                    Padding="10,6"
                    Click="DeselectAllButton_OnClick"
                    Style="{StaticResource DefaultButtonStyle}" />
                <Button
                    x:Name="InvertSelectionButton"
                    MinWidth="0"
                    Padding="10,6"
                    Click="InvertSelectionButton_OnClick"
                    Style="{StaticResource DefaultButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid
            x:Name="ListHost"
            Grid.Row="1"
            HorizontalAlignment="Stretch">
            <ScrollViewer
                x:Name="GroupsScroll"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Enabled">
                <StackPanel
                    x:Name="GroupsHost"
                    HorizontalAlignment="Center"
                    Spacing="0" />
            </ScrollViewer>
            <TextBlock
                x:Name="EmptyText"
                HorizontalAlignment="Center"
                Margin="0,24,0,24"
                Visibility="Collapsed"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</UserControl>
