<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="GlassSettings.Controls.HomeCustomizationFooterLine"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    SizeChanged="OnSizeChanged">

    <Grid VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Height="1"
            Margin="0,12,0,0"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- 12px под разделителем; снизу 0 — зазор до следующей карточки даёт RootStack Spacing (12), как у HomeCardPadding.Bottom+Spacing. -->
        <Border
            Grid.Row="1"
            MinHeight="{StaticResource HomeRowMinHeight}"
            Padding="0,12,0,0">
            <Grid
                x:Name="PartsRoot"
                VerticalAlignment="Center"
                RowSpacing="4">

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="*" />
                <ColumnDefinition x:Name="RightColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="CustomText"
                Grid.Column="0"
                Grid.Row="0"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="WrapWholeWords"
                VerticalAlignment="Center" />

            <StackPanel
                x:Name="UnsavedRow"
                Grid.Column="1"
                Grid.Row="0"
                Orientation="Horizontal"
                Spacing="12"
                VerticalAlignment="Center">

                <TextBlock
                    x:Name="UnsavedText"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextWrapping="WrapWholeWords"
                    VerticalAlignment="Center" />

                <ContentPresenter
                    x:Name="TrailingHost"
                    VerticalAlignment="Center" />
            </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
