<UserControl
    x:Class="GlassSettings.Controls.ThemePreviewChromeGlyph"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        x:Name="ChromeRoot"
        BorderThickness="0">
        <Grid x:Name="ContentHost" Margin="10,9,10,9">
            <StackPanel x:Name="LinesPanel" VerticalAlignment="Top" Spacing="8">
                <Rectangle x:Name="Line0" Height="1" RadiusX="0.5" RadiusY="0.5" />
                <Rectangle x:Name="Line1" Height="1" RadiusX="0.5" RadiusY="0.5" />
                <Rectangle x:Name="Line2" Height="1" RadiusX="0.5" RadiusY="0.5" />
                <Rectangle
                    x:Name="Line3"
                    Width="34"
                    Height="1"
                    HorizontalAlignment="Left"
                    RadiusX="0.5"
                    RadiusY="0.5" />
            </StackPanel>
            <Border
                x:Name="AccentStripe"
                Width="26"
                Height="7"
                Margin="0,0,1,1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                CornerRadius="2" />
        </Grid>
    </Border>
</UserControl>
