<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GlassSettings.Controls.HomeSettingsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch">
    <Border
        x:Name="CardBorder"
        Padding="{StaticResource HomeCardPadding}"
        HorizontalAlignment="Stretch"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel x:Name="CardRoot" Spacing="0">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <Grid x:Name="TopSection" RowSpacing="4" ColumnSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeadColumn" Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentPresenter
                    x:Name="LeadHost"
                    Grid.Row="0" Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Visibility="Collapsed" />
                <StackPanel x:Name="MainPanel" Grid.Row="0" Grid.Column="1" Spacing="4">
                    <StackPanel Spacing="2" Margin="0,0,0,4">
                        <TextBlock
                            x:Name="TitleText"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Name="DescriptionText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel x:Name="RowHost" Spacing="0" />
                </StackPanel>
                <!-- Нижний край: текст + кнопка (inline или stacked) -->
                <StackPanel
                    x:Name="RebootInline"
                    Grid.Row="0" Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Spacing="8"
                    Margin="0,0,24,0"
                    Visibility="Collapsed" />
                <StackPanel
                    x:Name="RebootStacked"
                    Grid.Row="1" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,4,24,0"
                    Spacing="8"
                    Visibility="Collapsed" />
            </Grid>
            <ContentPresenter
                x:Name="FooterHost"
                VerticalAlignment="Stretch"
                Visibility="Collapsed" />
        </StackPanel>
    </Border>
</UserControl>
