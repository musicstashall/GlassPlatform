<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GlassSettings.Controls.HomeDualGlassPlatformRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Stretch">
    <StackPanel Spacing="0">
        <Border
            x:Name="RowBorder"
            MinHeight="{StaticResource HomeRowMinHeight}"
            Padding="12,10"
            HorizontalAlignment="Stretch"
            Background="Transparent"
            PointerPressed="RowBorder_OnPointerPressed"
            PointerEntered="RowBorder_OnPointerEntered"
            PointerExited="RowBorder_OnPointerExited">
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    x:Name="IconGlyph"
                    Grid.Column="0"
                    Margin="{StaticResource GlassSettingsSectionIconMargin}"
                    FontSize="{StaticResource GlassSettingsSectionIconSize}"
                    VerticalAlignment="Center"
                    Glyph="&#xE943;" />
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="TitleX86"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse
                                    x:Name="DotX86"
                                    Width="6"
                                    Height="6"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="SubtitleX86"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                        <ContentPresenter
                            x:Name="GateX86Host"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="TitleX64"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse
                                    x:Name="DotX64"
                                    Width="6"
                                    Height="6"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="SubtitleX64"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                        <ContentPresenter
                            x:Name="GateX64Host"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
                <FontIcon
                    Grid.Column="3"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Glyph="&#xE76C;"
                    FontSize="16"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
        <Border
            x:Name="Divider"
            Height="1"
            Margin="12,0"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
    </StackPanel>
</UserControl>
