<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GlassSettings.Controls.AppSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <Grid MinWidth="580" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Spacing="4">
            <toolkit:SettingsCard x:Name="ThemeCard" Header="" Description="">
                <ComboBox
                    x:Name="ThemeCombo"
                    MinWidth="280"
                    HorizontalAlignment="Left"
                    SelectionChanged="ThemeCombo_OnSelectionChanged" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Name="BackdropCard" Header="" Description="">
                <ComboBox
                    x:Name="BackdropCombo"
                    MinWidth="280"
                    HorizontalAlignment="Left"
                    SelectionChanged="BackdropCombo_OnSelectionChanged" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Name="BusyOverlayCard" Header="" Description="">
                <ToggleSwitch
                    x:Name="BusyOverlaySwitch"
                    Style="{StaticResource GlassSettingsCompactToggleSwitchStyle}"
                    OnContent=""
                    OffContent=""
                    Toggled="BusyOverlaySwitch_OnToggled" />
            </toolkit:SettingsCard>
        </StackPanel>
        <Border
            Grid.Column="1"
            Padding="{StaticResource GlassSettingsOpacityRowPadding}"
            VerticalAlignment="Stretch"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel VerticalAlignment="Top" Spacing="8">
                <StackPanel Spacing="2">
                    <TextBlock
                        x:Name="LanguageLabel"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        x:Name="LanguageDescription"
                        Style="{StaticResource GlassSettingsSpoilerSecondaryTextStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox
                    x:Name="LanguageCombo"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="LanguageCombo_OnSelectionChanged" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
