<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GlassSettings.Controls.InjectRuntimeModuleTable"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <!-- ThemeResource (не снимок SolidColorBrush) — следует ActualTheme. -->
        <Style x:Key="RuntimeTableHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <StackPanel Spacing="0">
        <Grid
            x:Name="HeaderGrid"
            Margin="4,0,4,4"
            ColumnSpacing="4" />
        <Border
            Height="1"
            Margin="4,0,4,2"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <StackPanel x:Name="RowsHost" Spacing="0" />
    </StackPanel>
</UserControl>
