<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GlassSettings.Controls.SettingsProgressActionRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:GlassSettings.Controls"
    HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Stretch">
    <Border
        x:Name="RootBorder"
        MinHeight="{StaticResource GlassSettingsSystemExpanderHeaderMinHeight}"
        HorizontalAlignment="Stretch"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid>
            <Border
                x:Name="ProgressFill"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Background="{ThemeResource SystemFillColorSuccessBackground}"
                CornerRadius="8,0,0,8"
                Visibility="Collapsed" />
            <StackPanel
                x:Name="HeaderHost"
                Padding="{StaticResource GlassSettingsOpacityRowPadding}"
                Spacing="8">
                <ctrl:SpoilerHeaderGrid x:Name="HeaderChrome" ShowChevron="False" />
                <ContentControl
                    x:Name="ActionsBelowHost"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Right"
                    Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
