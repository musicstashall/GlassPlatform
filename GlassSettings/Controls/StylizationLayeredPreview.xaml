<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GlassSettings.Controls.StylizationLayeredPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Left"
    VerticalAlignment="Top">

    <!-- Каскад из 5 слоёв: обои → стекло → отражение → материал → окно.
         Каждый следующий слой меньше на inset снизу и справа, выше по Z (ThemeShadow),
         объявлен позже (рисуется поверх). Размеры/источники задаёт code-behind. -->
    <Grid x:Name="CascadeRoot">

        <!-- 1. Обои -->
        <Border
            x:Name="WallpaperLayer"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="#40000000"
            BorderThickness="1"
            CornerRadius="6"
            Translation="0,0,6">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid>
                <Grid x:Name="WallpaperVisualHost">
                    <Image
                        x:Name="WallpaperImageA"
                        Stretch="UniformToFill"
                        Visibility="Collapsed" />
                    <Image
                        x:Name="WallpaperImageB"
                        Stretch="UniformToFill"
                        Visibility="Collapsed" />
                    <Grid x:Name="WallpaperFallback">
                    <Rectangle Fill="{ThemeResource LayerFillColorDefaultBrush}" />
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="28"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xEB9F;" />
                    </Grid>
                </Grid>
                <Border Style="{StaticResource StylizationLayerLabelPillStyle}">
                    <TextBlock x:Name="WallpaperLabel" Style="{StaticResource StylizationLayerLabelTextStyle}" />
                </Border>
            </Grid>
        </Border>

        <!-- 2. Стекло -->
        <Border
            x:Name="GlassLayer"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            BorderBrush="#40FFFFFF"
            BorderThickness="1"
            CornerRadius="6"
            Translation="0,0,14">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid>
                <Grid x:Name="GlassVisualHost">
                    <Rectangle x:Name="GlassBlurFillA" />
                    <Rectangle
                        x:Name="GlassBlurFillB"
                        Opacity="0"
                        Visibility="Collapsed" />
                    <Rectangle
                        x:Name="GlassGlowFillA"
                        Visibility="Collapsed" />
                    <Rectangle
                        x:Name="GlassGlowFillB"
                        Opacity="0"
                        Visibility="Collapsed" />
                    <Rectangle x:Name="GlassTintFill" />
                    <Rectangle
                        x:Name="GlassOpaqueOverlay"
                        Fill="#55000000"
                        Visibility="Collapsed" />
                </Grid>
                <Border Style="{StaticResource StylizationLayerLabelPillStyle}">
                    <TextBlock x:Name="GlassLabel" Style="{StaticResource StylizationLayerLabelTextStyle}" />
                </Border>
            </Grid>
        </Border>

        <!-- 3. Отражение -->
        <Border
            x:Name="ReflectionLayer"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="Transparent"
            BorderBrush="#40000000"
            BorderThickness="1"
            CornerRadius="6"
            Translation="0,0,22">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid x:Name="ReflectionClip">
                <Rectangle
                    x:Name="ReflectionFallback"
                    Fill="{ThemeResource LayerFillColorAltBrush}" />
                <!-- 1:1 из верхнего левого угла; ImageBrush + Stretch=None — без поджима в габариты слоя. -->
                <Rectangle
                    x:Name="ReflectionTextureFill"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Visibility="Collapsed">
                    <Rectangle.Fill>
                        <ImageBrush
                            x:Name="ReflectionTextureBrush"
                            AlignmentX="Left"
                            AlignmentY="Top"
                            Stretch="None" />
                    </Rectangle.Fill>
                </Rectangle>
                <Border Style="{StaticResource StylizationLayerLabelPillStyle}">
                    <TextBlock x:Name="ReflectionLabel" Style="{StaticResource StylizationLayerLabelTextStyle}" />
                </Border>
            </Grid>
        </Border>

        <!-- 4. Материал -->
        <Border
            x:Name="MaterialLayer"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="Transparent"
            BorderBrush="#40000000"
            BorderThickness="1"
            CornerRadius="6"
            Translation="0,0,30">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid x:Name="MaterialClip">
                <Rectangle
                    x:Name="MaterialFallback"
                    Fill="{ThemeResource LayerFillColorAltBrush}" />
                <!-- Текстуру не масштабируем: прямоугольник из верхнего левого угла, ~35% opacity. -->
                <Image
                    x:Name="MaterialImage"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Opacity="0.35"
                    Stretch="None"
                    Visibility="Collapsed" />
                <Border Style="{StaticResource StylizationLayerLabelPillStyle}">
                    <TextBlock x:Name="MaterialLabel" Style="{StaticResource StylizationLayerLabelTextStyle}" />
                </Border>
            </Grid>
        </Border>

        <!-- 5. Атлас: мини-окно поверх каскада; прозрачные области PNG показывают слои ниже. -->
        <Border
            x:Name="WindowLayer"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="Transparent"
            BorderBrush="#40000000"
            BorderThickness="1"
            CornerRadius="6"
            Translation="0,0,38">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid x:Name="WindowClip">
                <Rectangle
                    x:Name="WindowFallback"
                    Fill="{ThemeResource LayerFillColorDefaultBrush}" />
                <Image
                    x:Name="WindowImage"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Stretch="None"
                    Visibility="Collapsed" />
                <Border Style="{StaticResource StylizationLayerLabelPillStyle}">
                    <TextBlock x:Name="WindowLabel" Style="{StaticResource StylizationLayerLabelTextStyle}" />
                </Border>
            </Grid>
        </Border>

    </Grid>
</UserControl>
