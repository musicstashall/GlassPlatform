<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GlassSettings.Controls.SpoilerHeaderControlsTable"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Left"
    VerticalAlignment="Center">
    <Grid
        x:Name="CellsGrid"
        ColumnSpacing="{StaticResource GlassSettingsRowControlSpacing}"
        HorizontalAlignment="Left"
        VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ContentPresenter x:Name="Cell0Host" VerticalAlignment="Center" />
        <ContentPresenter x:Name="Cell1Host" Grid.Column="1" VerticalAlignment="Center" />
    </Grid>
</UserControl>
