<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GlassSettings.Controls.AccentRecentColorSwatch"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="48"
    Height="48"
    IsTabStop="True"
    UseSystemFocusVisuals="True">
    <Border
        x:Name="RootBorder"
        Width="48"
        Height="48"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="4"
        PointerEntered="RootBorder_OnPointerEntered"
        PointerExited="RootBorder_OnPointerExited"
        PointerPressed="RootBorder_OnPointerPressed"
        PointerReleased="RootBorder_OnPointerReleased"
        Tapped="RootBorder_OnTapped">
        <Grid>
            <!-- Квадратик галочки: фон = chrome (тёмный в light / светлый в dark). -->
            <Border
                x:Name="CheckBadge"
                Width="14"
                Height="14"
                Margin="0,3,3,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                CornerRadius="2"
                Visibility="Collapsed">
                <FontIcon
                    x:Name="CheckIcon"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Glyph="&#xE73E;" />
            </Border>
        </Grid>
    </Border>
</UserControl>
