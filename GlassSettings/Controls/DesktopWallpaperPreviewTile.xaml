<UserControl
    x:Class="GlassSettings.Controls.DesktopWallpaperPreviewTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    Margin="3,3,1,1">
    <Border
        x:Name="RootBorder"
        Background="{ThemeResource LayerFillColorAltBrush}"
        BorderBrush="#FF1A1A1A"
        BorderThickness="3"
        CornerRadius="8"
        Translation="0,0,4">
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>
        <Grid>
            <Image
                x:Name="PreviewImageA"
                Stretch="UniformToFill"
                Visibility="Collapsed" />
            <Image
                x:Name="PreviewImageB"
                Stretch="UniformToFill"
                Visibility="Collapsed" />
            <Grid x:Name="PreviewFallback">
                <FontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="24"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE790;" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
